@inherits LayoutComponentBase

<header class="app-header">
    <span class="title">TradeViewer</span>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All" class="@ChartLinkClass">Chart</NavLink>
        <NavLink href="assets">Assets</NavLink>
        <NavLink href="settings">Settings</NavLink>
    </nav>
</header>

<main class="app-main">
    @Body
</main>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    /// <summary>The link "Chart" leads to the last chart and is the active one on every chart address.</summary>
    private string? ChartLinkClass => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("chart/", StringComparison.Ordinal) ? "active" : null;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (_, _) => StateHasChanged();
    }
}
