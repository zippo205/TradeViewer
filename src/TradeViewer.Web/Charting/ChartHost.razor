@implements IAsyncDisposable
@inject IJSRuntime JS

@* The C# wrapper of the chart module (architecture, chapter 10). Candles never pass through here:
   the module gets asset and timeframe and fetches the candles itself. Drawings pass as records with
   Unix seconds; the module reports what the user did with them. Indicators pass as the records of the chart
   settings; their values the module fetches itself. *@
<div class="chart-host" @ref="_element"></div>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _pane;
    private IJSObjectReference? _keys;
    private DotNetObjectReference<ChartHost>? _self;
    private string? _shownSeries;
    private bool _shownLogScale;
    private bool? _warning;

    /// <summary>
    /// The selection the chart has (as it reported it or was told), and the newest one wanted (by the page or the
    /// user in the chart). A selection is sent only when the newest wanted differs from the chart's: a push that
    /// resumes after an await never sends an older selection back, so chart and page cannot toggle forever.
    /// </summary>
    private string? _chartSelection;

    private string? _wantedSelection;

    /// <summary>The asset: source and symbol.</summary>
    [Parameter, EditorRequired]
    public string Source { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Symbol { get; set; } = string.Empty;

    /// <summary>The timeframe code, e.g. 1h.</summary>
    [Parameter, EditorRequired]
    public string Timeframe { get; set; } = string.Empty;

    /// <summary>The tick size of the asset; prices are shown with its precision (CH1).</summary>
    [Parameter]
    public double TickSize { get; set; } = 0.01;

    /// <summary>The timeframes of the asset with candles; the smallest gives anchors their exact times.</summary>
    [Parameter]
    public IReadOnlyList<string> Timeframes { get; set; } = Array.Empty<string>();

    /// <summary>
    /// When only the timeframe changes, show the same dates as before instead of the chart page's rule (CH3): the
    /// scenario pages go down from the context to the trigger on the dates the user looks at (SC2, SC21).
    /// </summary>
    [Parameter]
    public bool KeepTimesOnTimeframeChange { get; set; }

    /// <summary>Logarithmic price scale instead of the linear one (CH1).</summary>
    [Parameter]
    public bool LogScale { get; set; }

    /// <summary>The chart is ready for drawings, tool and options.</summary>
    [Parameter]
    public EventCallback OnReady { get; set; }

    /// <summary>The user finished a new drawing; it still lacks source, symbol and version.</summary>
    [Parameter]
    public EventCallback<ChartDrawing> OnDrawingCreated { get; set; }

    /// <summary>The user moved or reshaped a drawing; reported once, when the pointer is let go (NF3).</summary>
    [Parameter]
    public EventCallback<ChartDrawing> OnDrawingChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnSelectionChanged { get; set; }

    /// <summary>The tool in use; null is the pointer, to which the chart returns after a drawing.</summary>
    [Parameter]
    public EventCallback<string?> OnToolChanged { get; set; }

    /// <summary>An action of the legend line of an indicator: its id and hide, settings or remove (IN1).</summary>
    [Parameter]
    public EventCallback<(string Id, string Action)> OnIndicatorAction { get; set; }

    /// <summary>A named point placed with a tool or let go after a drag (SC10); the page has it snapped by the server.</summary>
    [Parameter]
    public EventCallback<PlacedPoint> OnPointPlaced { get; set; }

    /// <summary>The selected named point ("field" or "field#index"), null when none.</summary>
    [Parameter]
    public EventCallback<string?> OnPointSelected { get; set; }

    /// <summary>The point tool in use; null after its last point or Escape.</summary>
    [Parameter]
    public EventCallback<string?> OnScenarioToolChanged { get; set; }

    /// <summary>A key of the chart page: delete, undo or redo.</summary>
    [Parameter]
    public EventCallback<string> OnKey { get; set; }

    public bool IsReady => _pane != null;

    /// <summary>New candles may exist: the chart reads its newest candles again and keeps its view (MD2).</summary>
    public async Task RefreshAsync()
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("refresh");
        }
    }

    public async Task SetDrawingsAsync(IReadOnlyList<ChartDrawing> drawings, string? selected)
    {
        _wantedSelection = selected;
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("setDrawings", drawings);
            if (_wantedSelection != _chartSelection)
            {
                _chartSelection = _wantedSelection;
                await _pane.InvokeVoidAsync("selectDrawing", _wantedSelection);
            }
        }
    }

    /// <summary>
    /// The indicators of the asset (IN1), as the chart settings hold them. The module fetches their values itself and
    /// keeps the values of indicators whose parameters did not change.
    /// </summary>
    public async Task SetIndicatorsAsync(IReadOnlyList<IndicatorRecord> indicators)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("setIndicators", indicators);
        }
    }

    /// <summary>Loads the series again from its newest candles, e.g. after its history was moved back (SC6).</summary>
    public Task ReloadSeriesAsync()
    {
        _shownSeries = null;
        return ApplyAsync();
    }

    /// <summary>Read-only shapes as the Api gives them (OV1-OV6, SC8); the groups whose keys are given are hidden (SC21).</summary>
    public async Task SetOverlaysAsync(IReadOnlyList<OverlayGroupRecord> groups, IReadOnlyList<string> hiddenKeys)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("setOverlays", groups, hiddenKeys);
        }
    }

    /// <summary>Positions the chart on a time span, loading older candles as far as it needs (SC2).</summary>
    public async Task ShowTimeRangeAsync(DateTimeOffset from, DateTimeOffset to)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("showTimeRange", from.ToUnixTimeSeconds(), to.ToUnixTimeSeconds());
        }
    }

    /// <summary>The named points of a scenario; those of the level shown are editable (SC10).</summary>
    public async Task SetScenarioPointsAsync(IReadOnlyList<ScenarioHandle> points)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("setScenarioPoints", points);
        }
    }

    /// <summary>A point tool, or the pointer with null.</summary>
    public async Task SetScenarioToolAsync(ScenarioTool? tool)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("setScenarioTool", tool);
        }
    }

    public async Task SelectScenarioPointAsync(string? key)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("selectScenarioPoint", key);
        }
    }

    /// <summary>The tool to place next; null for the pointer.</summary>
    /// <param name="extras">Fields the new drawing gets, e.g. <c>new { wave = new { degree, label } }</c> for a wave label.</param>
    public async Task SetToolAsync(string? tool, object? extras = null)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("setTool", tool, null, extras);
        }
    }

    public async Task SetDrawingOptionsAsync(bool magnet, bool hidden)
    {
        if (_pane != null)
        {
            await _pane.InvokeVoidAsync("setDrawingOptions", new { magnet, hidden });
        }
    }

    /// <summary>While a change is not saved, closing or reloading the window asks first.</summary>
    public async Task WarnWhenLeavingAsync(bool on)
    {
        if (_module != null && _warning != on)
        {
            _warning = on;
            await _module.InvokeVoidAsync("warnWhenLeaving", on);
        }
    }

    [JSInvokable]
    public Task DrawingCreated(ChartDrawing drawing)
    {
        return OnDrawingCreated.InvokeAsync(drawing);
    }

    [JSInvokable]
    public Task DrawingChanged(ChartDrawing drawing)
    {
        return OnDrawingChanged.InvokeAsync(drawing);
    }

    [JSInvokable]
    public Task SelectionChanged(string? id)
    {
        _chartSelection = id;
        _wantedSelection = id;
        return OnSelectionChanged.InvokeAsync(id);
    }

    [JSInvokable]
    public Task ToolChanged(string? tool)
    {
        return OnToolChanged.InvokeAsync(tool);
    }

    [JSInvokable]
    public Task IndicatorAction(string id, string action)
    {
        return OnIndicatorAction.InvokeAsync((id, action));
    }

    [JSInvokable]
    public Task PointPlaced(string field, int? index, double time, double price, string? kind)
    {
        return OnPointPlaced.InvokeAsync(new PlacedPoint(field, index, (long)time, price, kind));
    }

    [JSInvokable]
    public Task PointSelected(string? key)
    {
        return OnPointSelected.InvokeAsync(key);
    }

    [JSInvokable]
    public Task ScenarioToolChanged(string? tool)
    {
        return OnScenarioToolChanged.InvokeAsync(tool);
    }

    [JSInvokable]
    public Task Key(string key)
    {
        return OnKey.InvokeAsync(key);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./chart/index.js");
            _pane = await _module.InvokeAsync<IJSObjectReference>("createPane", _element, new { logScale = LogScale });
            _shownLogScale = LogScale;
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("bindDrawingEvents", _pane, _self);
            await _module.InvokeVoidAsync("bindIndicatorActions", _pane, _self);
            await _module.InvokeVoidAsync("bindScenarioEvents", _pane, _self);
            _keys = await _module.InvokeAsync<IJSObjectReference>("bindPageKeys", _self);
            await ApplyAsync();
            await OnReady.InvokeAsync();
            return;
        }

        await ApplyAsync();
    }

    public async ValueTask DisposeAsync()
    {
        // A page may still hold this component after it left the page (a chart removed and made again): from now on
        // it is not ready and every call does nothing.
        var pane = _pane;
        var module = _module;
        _pane = null;
        _module = null;
        try
        {
            if (_keys != null)
            {
                await _keys.InvokeVoidAsync("dispose");
                await _keys.DisposeAsync();
            }

            if (pane != null)
            {
                await pane.InvokeVoidAsync("dispose");
                await pane.DisposeAsync();
            }

            if (module != null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // the page is closing; there is nothing left to tidy up
        }

        _self?.Dispose();
    }

    /// <summary>The dates in view, as the module reports them (Unix seconds).</summary>
    private sealed record TimeWindow(long From, long To);

    /// <summary>Tells the module what changed since the last render, and nothing when nothing did.</summary>
    private async Task ApplyAsync()
    {
        if (_pane == null)
        {
            return;
        }

        if (_shownLogScale != LogScale)
        {
            _shownLogScale = LogScale;
            await _pane.InvokeVoidAsync("setOptions", new { logScale = LogScale });
        }

        var asset = Source + "/" + Symbol + "/";
        var series = asset + Timeframe;
        if (_shownSeries != series && Source.Length > 0 && Symbol.Length > 0 && Timeframe.Length > 0)
        {
            var sameAsset = _shownSeries != null && _shownSeries.StartsWith(asset, StringComparison.Ordinal);
            var window = KeepTimesOnTimeframeChange && sameAsset ? await _pane.InvokeAsync<TimeWindow?>("visibleTimeRange") : null;
            _shownSeries = series;
            await _pane.InvokeVoidAsync("setSeries", new { source = Source, symbol = Symbol, timeframe = Timeframe, tickSize = TickSize, timeframes = Timeframes });
            if (window != null)
            {
                await _pane.InvokeVoidAsync("showTimeRange", window.From, window.To, false);
            }
        }
    }
}
