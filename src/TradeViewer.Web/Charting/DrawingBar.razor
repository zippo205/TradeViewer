@* The bar of the selected drawing (DR2): colour, width, line style, fill, text, lock and delete. It does what a
   context menu would. A locked drawing offers only to be unlocked. *@
<div class="drawing-bar" role="toolbar" aria-label="Selected drawing">
    <span class="drawing-bar-swatches">
        @foreach (var color in Palette)
        {
            <button type="button" class="swatch @(Same(color, Drawing.Style.Color) ? "selected" : "")" style="background:@color"
                    title="@color" disabled="@Drawing.Locked" @onclick="() => SetColor(color)"></button>
        }

        <input type="color" title="Another colour" value="@Rgb(Drawing.Style.Color)" disabled="@Drawing.Locked"
               @onchange="e => SetColor(e.Value?.ToString() ?? Drawing.Style.Color)" />
    </span>

    <span class="segments" role="group" aria-label="Width">
        @for (var width = 1; width <= 4; width++)
        {
            var value = width;
            <button type="button" class="@(Drawing.Style.Width == value ? "selected" : "")" title="Width @value px" disabled="@Drawing.Locked"
                    @onclick="() => Edit(Drawing with { Style = Drawing.Style with { Width = value } })">@value</button>
        }
    </span>

    <select title="Line style" value="@Drawing.Style.LineStyle" disabled="@Drawing.Locked"
            @onchange="e => Edit(Drawing with { Style = Drawing.Style with { LineStyle = e.Value?.ToString() ?? Drawing.Style.LineStyle } })">
        <option value="solid">solid</option>
        <option value="dashed">dashed</option>
        <option value="dotted">dotted</option>
    </select>

    @if (Drawing.Tool == "rectangle" || Drawing.Tool == "parallelChannel")
    {
        <label title="Fill the area">
            <input type="checkbox" checked="@(Drawing.Style.Fill != null)" disabled="@Drawing.Locked"
                   @onchange="e => Edit(Drawing with { Style = Drawing.Style with { Fill = e.Value is true ? Pale(Drawing.Style.Color) : null } })" />
            fill
        </label>
    }

    @if (Drawing.Tool == "textNote")
    {
        <input type="text" class="drawing-bar-text" aria-label="Text" value="@Drawing.Text" maxlength="2000" disabled="@Drawing.Locked"
               @onchange="e => SetText(e.Value?.ToString())" />
    }

    @if (Drawing.Tool == "waveLabel" && Drawing.Wave != null)
    {
        var wave = Drawing.Wave;
        <select title="Degree" value="@wave.Degree" disabled="@Drawing.Locked"
                @onchange="e => Edit(Drawing with { Wave = wave with { Degree = e.Value?.ToString() ?? wave.Degree } })">
            @foreach (var degree in WaveLabels.Degrees)
            {
                <option value="@degree.Code">@degree.Title</option>
            }
        </select>
        <select title="Label" value="@wave.Label" disabled="@Drawing.Locked"
                @onchange="e => Edit(Drawing with { Wave = wave with { Label = e.Value?.ToString() ?? wave.Label } })">
            @foreach (var label in WaveLabels.Labels)
            {
                <option value="@label">@WaveLabels.Written(wave.Degree, label)</option>
            }
        </select>
        <button type="button" title="Put the label on the other side of the candle" disabled="@Drawing.Locked"
                @onclick="() => FlipSide(wave)">
            @wave.Side
        </button>
    }

    @if (Drawing.Tool == "polyline")
    {
        <label title="Show the line; without it only the labels show">
            <input type="checkbox" checked="@(!Drawing.LineHidden)" disabled="@Drawing.Locked"
                   @onchange="e => Edit(Drawing with { LineHidden = e.Value is not true })" />
            line
        </label>
        @if (Drawing.PointLabels?.Count > 0)
        {
            @* A count (a wave pattern, or labelled points): its degree is changed for all its labels at once. *@
            <select title="Degree of the labels" value="@Drawing.PointLabels[0].Mark.Degree" disabled="@Drawing.Locked"
                    @onchange="e => SetCountDegree(e.Value?.ToString())">
                @foreach (var degree in WaveLabels.Degrees)
                {
                    <option value="@degree.Code">@degree.Title</option>
                }
            </select>
            <button type="button" title="Remove the labels of the points" disabled="@Drawing.Locked"
                    @onclick="() => Edit(Drawing with { PointLabels = null })">no labels</button>
        }
        else
        {
            <select title="Degree of the labels" @bind="_countDegree" disabled="@Drawing.Locked">
                @foreach (var degree in WaveLabels.Degrees)
                {
                    <option value="@degree.Code">@degree.Title</option>
                }
            </select>
            <select title="Label of the second point" @bind="_countFirst" disabled="@Drawing.Locked">
                @foreach (var label in WaveLabels.Labels)
                {
                    <option value="@label">@WaveLabels.Written(_countDegree, label)</option>
                }
            </select>
            <button type="button" title="Label the points after the first: highs above, lows below" disabled="@Drawing.Locked"
                    @onclick="() => Edit(Drawing with { PointLabels = WaveLabels.ForPoints(Drawing.Anchors, _countDegree, _countFirst) })">
                label points
            </button>
        }
    }

    @if (Drawing.Levels != null)
    {
        <button type="button" class="@(_levelsOpen ? "selected" : "")" title="Switch the levels of this drawing on and off"
                aria-expanded="@(_levelsOpen ? "true" : "false")" @onclick="() => _levelsOpen = !_levelsOpen">levels</button>
    }

    <button type="button" class="@(Drawing.Locked ? "selected" : "")" aria-pressed="@(Drawing.Locked ? "true" : "false")"
            title="@(Drawing.Locked ? "Unlock" : "Lock: it can then not be moved, changed or deleted")"
            @onclick="() => Edit(Drawing with { Locked = !Drawing.Locked })">
        @(Drawing.Locked ? "locked" : "lock")
    </button>
    <button type="button" class="danger" title="Delete (Del)" disabled="@Drawing.Locked" @onclick="OnDelete">delete</button>

    @if (_levelsOpen && Drawing.Levels != null)
    {
        @* The levels of this drawing, each on or off (DR4); the preset it came from does not change. *@
        <div class="drawing-bar-levels" role="group" aria-label="Levels">
            @for (var index = 0; index < Drawing.Levels.Count; index++)
            {
                var at = index;
                var level = Drawing.Levels[at];
                <label class="preset-level @(level.Visible ? "" : "off")">
                    <input type="checkbox" checked="@level.Visible" disabled="@Drawing.Locked" @onchange="e => SetLevel(at, e.Value is true)" />
                    @level.Ratio.ToString(System.Globalization.CultureInfo.InvariantCulture)
                </label>
            }
        </div>
    }
</div>

@code {
    /// <summary>Blue of the lines, then the colours of the application and a neutral gray (OV6).</summary>
    private static readonly string[] Palette = { "#2962FF", "#F23645", "#089981", "#FF9800", "#9C27B0", "#787B86" };

    /// <summary>Degree and first label for "label points" of a polyline; they start where the chooser is.</summary>
    private string _countDegree = WaveLabels.FirstDegree;

    private string _countFirst = "1";

    /// <summary>The degree and label of the chooser, offered when the points of a polyline are labelled.</summary>
    [Parameter]
    public (string Degree, string Label) Wave { get; set; } = (WaveLabels.FirstDegree, "1");

    private Guid _shownId;

    protected override void OnParametersSet()
    {
        // Another drawing selected: the count starts where the chooser is.
        if (Drawing.Id != _shownId)
        {
            _shownId = Drawing.Id;
            _countDegree = Wave.Degree;
            _countFirst = Wave.Label;
        }
    }

    [Parameter, EditorRequired]
    public DrawingRecord Drawing { get; set; } = null!;

    [Parameter]
    public EventCallback<DrawingRecord> OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    private Task Edit(DrawingRecord changed)
    {
        return OnEdit.InvokeAsync(changed);
    }

    /// <summary>A new colour also colours the fill of an area, which stays pale.</summary>
    private Task SetColor(string color)
    {
        var fill = Drawing.Style.Fill == null ? null : Pale(color);
        return Edit(Drawing with { Style = Drawing.Style with { Color = color.ToUpperInvariant(), Fill = fill } });
    }

    private bool _levelsOpen;

    /// <summary>A level of this Fibonacci drawing switched on or off.</summary>
    private Task SetLevel(int index, bool visible)
    {
        var levels = Drawing.Levels!.Select((level, at) => at == index ? level with { Visible = visible } : level).ToList();
        return Edit(Drawing with { Levels = levels });
    }

    /// <summary>All labels of a count take the degree.</summary>
    private Task SetCountDegree(string? degree)
    {
        if (degree == null || Drawing.PointLabels == null)
        {
            return Task.CompletedTask;
        }

        var labels = Drawing.PointLabels.Select(label => label with { Mark = label.Mark with { Degree = degree } }).ToList();
        return Edit(Drawing with { PointLabels = labels });
    }

    /// <summary>The label goes to the other side of its candle: from the high to the low, or back.</summary>
    private Task FlipSide(WaveMarkRecord wave)
    {
        return Edit(Drawing with { Wave = wave with { Side = wave.Side == "above" ? "below" : "above" } });
    }

    /// <summary>A text note keeps a text: an empty one would be refused by the server.</summary>
    private Task SetText(string? text)
    {
        return string.IsNullOrWhiteSpace(text) ? Task.CompletedTask : Edit(Drawing with { Text = text });
    }

    /// <summary>The colour at about 10 % opacity, as rectangles and channels are filled by default.</summary>
    private static string Pale(string color)
    {
        return Rgb(color).ToUpperInvariant() + "1A";
    }

    /// <summary>#RRGGBB of a colour that may have an alpha part; the colour input knows no alpha.</summary>
    private static string Rgb(string color)
    {
        return color.Length >= 7 ? color.Substring(0, 7) : color;
    }

    private static bool Same(string a, string b)
    {
        return string.Equals(Rgb(a), Rgb(b), StringComparison.OrdinalIgnoreCase);
    }
}
