@page "/settings"
@inject WorkspaceApi Workspace

<PageTitle>Settings - TradeViewer</PageTitle>

<h1>Settings</h1>

<section>
    <h2>Default history</h2>
    <p class="muted">
        How much history a new asset gets per timeframe, counted back from the day it is added. The source may
        provide less. Assets you have already keep their history; change it on the assets page.
    </p>

    @if (_history == null)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        <table class="list">
            <thead>
                <tr>
                    <th>Timeframe</th>
                    <th>History</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _history)
                {
                    <tr @key="row.Timeframe">
                        <td>@row.Timeframe</td>
                        <td>
                            <label><input type="checkbox" @bind="row.Complete" /> complete</label>
                            <input type="number" min="1" max="36500" @bind="row.Days" disabled="@row.Complete" /> days
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="toolbar">
            <button type="button" disabled="@_busy" @onclick="SaveHistoryAsync">Save</button>
        </div>

        @if (_historyMessage != null)
        {
            <p class="@(_historyFailed ? "status-bad" : "status-ok")">@_historyMessage</p>
        }
    }
</section>

<section>
    <h2>Backups</h2>
    <p class="muted">
        The workspace (everything you create) is backed up once a day; the newest backups are kept.
        Times are UTC. A restore replaces the whole workspace and cannot be undone.
    </p>

    <div class="toolbar">
        <button type="button" disabled="@_busy" @onclick="BackUpNowAsync">Back up now</button>
        <label class="button @(_busy ? "disabled" : "")">
            Restore from a file...
            <InputFile @key="_fileInputKey" OnChange="SelectFile" accept=".db" disabled="@_busy" hidden />
        </label>
    </div>

    @if (_file != null)
    {
        <p class="confirm">
            Replace the workspace by the file @_file.Name?
            <button type="button" class="danger" disabled="@_busy" @onclick="RestoreFileAsync">Restore</button>
            <button type="button" disabled="@_busy" @onclick="ClearFile">Cancel</button>
        </p>
    }

    @if (_message != null)
    {
        <p class="@(_failed ? "status-bad" : "status-ok")">@_message</p>
    }

    @if (_backups == null)
    {
        <p class="muted">Loading...</p>
    }
    else if (_backups.Count == 0)
    {
        <p class="muted">No backups yet.</p>
    }
    else
    {
        <table class="list">
            <thead>
                <tr>
                    <th>Created (UTC)</th>
                    <th>Kind</th>
                    <th class="number">Size</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var backup in _backups)
                {
                    <tr @key="backup.Name">
                        <td>@backup.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                        <td>@KindText(backup.Kind)</td>
                        <td class="number">@SizeText(backup.SizeBytes)</td>
                        <td class="actions">
                            @if (_confirmName == backup.Name)
                            {
                                <span>Replace the workspace by this backup?</span>
                                <button type="button" class="danger" disabled="@_busy" @onclick="() => RestoreAsync(backup.Name)">Restore</button>
                                <button type="button" disabled="@_busy" @onclick="() => _confirmName = null">Cancel</button>
                            }
                            else
                            {
                                <a href="@WorkspaceApi.DownloadAddress(backup.Name)" download="@backup.Name">Download</a>
                                <button type="button" disabled="@_busy" @onclick="() => _confirmName = backup.Name">Restore...</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private static readonly string[] TimeframeOrder = { "15m", "1h", "4h", "1d", "1w" };

    private IReadOnlyList<BackupResponse>? _backups;
    private List<HistoryRow>? _history;
    private string? _historyMessage;
    private bool _historyFailed;
    private IBrowserFile? _file;
    private Guid _fileInputKey = Guid.NewGuid();
    private string? _confirmName;
    private string? _message;
    private bool _failed;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryAsync();
        await LoadAsync();
    }

    private async Task LoadHistoryAsync()
    {
        var result = await Workspace.GetSettingsAsync();
        if (result.Value == null)
        {
            _history = new List<HistoryRow>();
            _historyMessage = result.Error;
            _historyFailed = true;
            return;
        }

        _history = ToRows(result.Value);
    }

    private async Task SaveHistoryAsync()
    {
        _busy = true;
        try
        {
            var days = _history!.ToDictionary(row => row.Timeframe, row => row.Complete ? (int?)null : row.Days);
            var result = await Workspace.SaveSettingsAsync(new SettingsResponse(days));

            _historyFailed = result.Error != null;
            _historyMessage = result.Error ?? "Saved. It counts for the assets you add from now on.";
            if (result.Value != null)
            {
                _history = ToRows(result.Value);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static List<HistoryRow> ToRows(SettingsResponse settings)
    {
        return (settings.DefaultHistory ?? new Dictionary<string, int?>())
            .OrderBy(pair => Array.IndexOf(TimeframeOrder, pair.Key))
            .Select(pair => new HistoryRow { Timeframe = pair.Key, Complete = pair.Value == null, Days = pair.Value ?? 365 })
            .ToList();
    }

    private async Task LoadAsync()
    {
        try
        {
            _backups = await Workspace.GetBackupsAsync();
        }
        catch (HttpRequestException)
        {
            _backups = new List<BackupResponse>();
            Show("The server is not reachable.", true);
        }
    }

    private Task BackUpNowAsync()
    {
        return RunAsync(() => Workspace.CreateBackupAsync(), "Backup made.");
    }

    private Task RestoreAsync(string name)
    {
        _confirmName = null;
        return RunAsync(() => Workspace.RestoreAsync(name), "The workspace was restored. Reload the other windows of TradeViewer.");
    }

    private async Task RestoreFileAsync()
    {
        var file = _file!;
        if (file.Size > BackupLimits.MaxUploadBytes)
        {
            Show("The file is larger than " + SizeText(BackupLimits.MaxUploadBytes) + ".", true);
            ClearFile();
            return;
        }

        await RunAsync(
            async () =>
            {
                await using var stream = file.OpenReadStream(BackupLimits.MaxUploadBytes);
                return await Workspace.RestoreFileAsync(stream);
            },
            "The workspace was restored. Reload the other windows of TradeViewer.");
        ClearFile();
    }

    private void SelectFile(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _message = null;
    }

    private void ClearFile()
    {
        _file = null;
        _fileInputKey = Guid.NewGuid(); // a new input, so the same file can be chosen again
    }

    private async Task RunAsync(Func<Task<string?>> command, string done)
    {
        _busy = true;
        _message = null;
        try
        {
            var error = await command();
            Show(error ?? done, error != null);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void Show(string message, bool failed)
    {
        _message = message;
        _failed = failed;
    }

    private static string KindText(string kind)
    {
        switch (kind)
        {
            case "daily":
                return "Daily";
            case "manual":
                return "Manual";
            case "before-upgrade":
                return "Before an update";
            default:
                return kind;
        }
    }

    private static string SizeText(long bytes)
    {
        if (bytes < 1024 * 1024)
        {
            return (bytes / 1024.0).ToString("0.#", CultureInfo.InvariantCulture) + " KB";
        }

        return (bytes / (1024.0 * 1024.0)).ToString("0.#", CultureInfo.InvariantCulture) + " MB";
    }

    private sealed class HistoryRow
    {
        public string Timeframe { get; set; } = string.Empty;

        public bool Complete { get; set; }

        public int Days { get; set; }
    }
}
