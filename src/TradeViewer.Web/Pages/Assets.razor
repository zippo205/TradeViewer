@page "/assets"
@implements IDisposable
@inject AssetsApi Api
@inject WatchlistsApi Watchlists
@inject WorkspaceEvents Events

<PageTitle>Assets - TradeViewer</PageTitle>

<h1>Assets</h1>

@if (_message != null)
{
    <p class="@(_failed ? "status-bad" : "status-ok")">@_message</p>
}

<section>
    <h2>Add an asset</h2>
    <p class="muted">
        Choose the source and type the start of the ticker or a part of the name, then choose a symbol to see what
        the Downloader has of it. The asset gets the default history of the settings; the Downloader loads it and
        TradeViewer imports it in the background. Stocks, ETFs and forex follow once TradeViewer can chart them.
    </p>

    <div class="toolbar">
        <select @bind="_source" @bind:after="SearchAsync" disabled="@_busy">
            @foreach (var source in Sources)
            {
                <option value="@source">@source</option>
            }
        </select>
        <input type="search" placeholder="Ticker or name" maxlength="40" value="@_search" @oninput="OnSearchInput" />
    </div>

    @if (_details != null)
    {
        <div class="symbol-details" role="region" aria-label="Chosen symbol">
            <strong>@_details.DisplayName</strong>
            <span class="muted">@_details.Source / @_details.SourceSymbol@(_details.SourceSymbol != _details.Symbol ? " (folder " + _details.Symbol + ")" : "") · @_details.AssetClass</span>
            <dl>
                <dt>Tick size</dt>
                <dd>@_details.TickSize.ToString(CultureInfo.InvariantCulture)</dd>
                <dt>Session</dt>
                <dd>@SessionText(_details)</dd>
                <dt>Timeframes</dt>
                <dd>@string.Join(", ", _details.Timeframes)</dd>
                @if (_details.Earliest.Count > 0)
                {
                    <dt>Earliest</dt>
                    <dd>@string.Join(", ", _details.Earliest.Select(pair => pair.Key + " " + pair.Value))</dd>
                }
            </dl>
            <div class="toolbar">
                @if (_details.Added)
                {
                    <span class="muted">already one of your assets</span>
                }
                else
                {
                    <button type="button" disabled="@_busy" @onclick="AddChosenAsync">Add @_details.SourceSymbol</button>
                }
                <button type="button" disabled="@_busy" @onclick="() => _details = null">Cancel</button>
            </div>
        </div>
    }

    @if (_symbols == null)
    {
        <p class="muted">Loading...</p>
    }
    else if (_symbols.FromCatalog && _symbols.RefreshedAt == null)
    {
        <p class="muted">The Downloader has no list of @_source yet; it loads it in the background. Try again in a minute.</p>
    }
    else if (_symbols.Symbols.Count == 0)
    {
        <p class="muted">No symbol of @_source matches.</p>
    }
    else
    {
        @if (_symbols.Truncated)
        {
            <p class="muted">@_symbols.Symbols.Count of @_symbols.Total matches shown. Type more to narrow it down.</p>
        }
        else if (!_symbols.FromCatalog)
        {
            <p class="muted">The Downloader is switched off: the symbols come from the list that is part of TradeViewer.</p>
        }

        <table class="list">
            <tbody>
                @foreach (var symbol in _symbols.Symbols)
                {
                    <tr @key="symbol.Symbol">
                        <td>@(symbol.SourceSymbol ?? symbol.Symbol)</td>
                        <td>@symbol.DisplayName</td>
                        <td class="muted">@symbol.AssetClass@(symbol.Exchange == null ? "" : " · " + symbol.Exchange)</td>
                        <td class="actions">
                            @if (symbol.Added)
                            {
                                <span class="muted">added</span>
                            }
                            else
                            {
                                <button type="button" disabled="@_busy" @onclick="() => ChooseAsync(symbol)">Choose</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Your watchlists</h2>
    <p class="muted">
        An asset is in the watchlist of its asset class. Drag an asset to another place in its list, or use the
        arrows, to change the order; the watchlists next to the chart follow.
    </p>

    @if (_assets == null)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        @foreach (var list in Lists)
        {
            var inList = _assets.Where(item => item.AssetClass == list.Code).ToList();
            <h3 class="watchlist-heading">@list.Title <span class="count">@inList.Count</span></h3>
            @if (inList.Count == 0)
            {
                <p class="muted">No assets.</p>
            }

        @foreach (var asset in inList)
        {
            var index = inList.IndexOf(asset);
            <article class="card @(_dragKey == Key(asset) ? "dragging" : "") @(_dropKey == Key(asset) && _dragKey != Key(asset) ? "drop-target" : "")"
                     @key="Key(asset)"
                     draggable="true"
                     @ondragstart="() => StartDrag(asset)"
                     @ondragenter="() => EnterDrop(asset)"
                     @ondragover:preventDefault="true"
                     @ondragover="() => { }"
                     @ondrop="() => DropOnAsync(asset)"
                     @ondragend="EndDrag">
                <header>
                    <span class="order-buttons">
                        <button type="button" title="Move up" disabled="@(_busy || index == 0)" @onclick="() => MoveAsync(asset, index - 1)">&#8593;</button>
                        <button type="button" title="Move down" disabled="@(_busy || index == inList.Count - 1)" @onclick="() => MoveAsync(asset, index + 1)">&#8595;</button>
                    </span>
                    <strong>@asset.DisplayName</strong>
                    @if (asset.Timeframes.Any(timeframe => timeframe.Chartable))
                    {
                        <a href="@ChartAddress(asset)">Chart</a>
                    }
                    <span class="muted">@asset.Source / @asset.Symbol · @asset.AssetClass</span>
                    @if (asset.Loading)
                    {
                        <span class="badge loading">loading</span>
                    }
                    @if (asset.SubscriptionPending)
                    {
                        <span class="badge warning" title="The Downloader could not be reached; the history is sent again.">history not sent yet</span>
                    }
                    @if (asset.Errors.Count > 0)
                    {
                        <span class="badge warning">@asset.Errors.Count file(s) not imported</span>
                    }
                    @if (GapsOf(asset) > 0)
                    {
                        <span class="badge" title="Candles the source does not have; the chart marks where (MD4)">@DownloaderStatusText.GapCount(GapsOf(asset))</span>
                    }
                </header>

                @* Folded by default, so a watchlist is a short list that can be reordered. The browser keeps
                   whether it is open; Blazor does not touch that. *@
                <details class="card-details">
                <summary>Details: history, files, actions</summary>

                <table class="list">
                    <thead>
                        <tr>
                            <th>Timeframe</th>
                            <th>History from</th>
                            <th>First candle (UTC)</th>
                            <th>Last candle (UTC)</th>
                            <th class="number">Files</th>
                            <th>State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var timeframe in asset.Timeframes)
                        {
                            <tr @key="timeframe.Timeframe">
                                <td>@timeframe.Timeframe</td>
                                <td>
                                    @if (_editKey == Key(asset))
                                    {
                                        var edit = _edit[timeframe.Timeframe];
                                        <label><input type="checkbox" @bind="edit.Complete" /> complete</label>
                                        <input type="date" @bind="edit.From" disabled="@edit.Complete" />
                                    }
                                    else
                                    {
                                        @(timeframe.HistoryFrom ?? "complete")
                                    }
                                </td>
                                <td>@TimeText(timeframe.FirstCandle)</td>
                                <td>@TimeText(timeframe.LastCandle)</td>
                                <td class="number">@timeframe.FilesImported / @timeframe.FilesWanted</td>
                                <td>
                                    @if (timeframe.Loading)
                                    {
                                        <span>@(timeframe.Chartable ? "loading, can be charted" : "loading")</span>
                                    }
                                    else if (timeframe.Chartable)
                                    {
                                        <span class="status-ok">ready</span>
                                    }
                                    else
                                    {
                                        <span class="muted">no candles</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @foreach (var timeframe in asset.Timeframes.Where(item => item.Gaps.Count > 0))
                {
                    <details class="gap-list">
                        <summary>@timeframe.Timeframe: @DownloaderStatusText.GapCount(timeframe.Gaps.Count) the source confirmed</summary>
                        <ul>
                            @foreach (var gap in timeframe.Gaps)
                            {
                                <li>@GapText(gap)</li>
                            }
                        </ul>
                    </details>
                }

                @if (asset.Errors.Count > 0)
                {
                    <ul class="status-bad">
                        @foreach (var error in asset.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }

                <div class="toolbar">
                    @if (_editKey == Key(asset))
                    {
                        <button type="button" disabled="@_busy" @onclick="() => SaveHistoryAsync(asset)">Save history</button>
                        <button type="button" disabled="@_busy" @onclick="() => _editKey = null">Cancel</button>
                    }
                    else if (_removeKey == Key(asset))
                    {
                        <span>
                            Remove @asset.DisplayName? Its candles, drawings and chart settings are deleted from TradeViewer
                            and its subscription at the Downloader ends. The files of the Downloader stay.
                        </span>
                        <button type="button" class="danger" disabled="@_busy" @onclick="() => RemoveAsync(asset)">Remove</button>
                        <button type="button" disabled="@_busy" @onclick="() => _removeKey = null">Cancel</button>
                    }
                    else if (_rebuildKey == Key(asset))
                    {
                        <span>Delete the stored candles of @asset.DisplayName and import them again from the Downloader's files?</span>
                        <button type="button" disabled="@_busy" @onclick="() => RebuildAsync(asset)">Rebuild</button>
                        <button type="button" disabled="@_busy" @onclick="() => _rebuildKey = null">Cancel</button>
                    }
                    else
                    {
                        <button type="button" disabled="@_busy" @onclick="() => EditHistory(asset)">History...</button>
                        <button type="button" disabled="@_busy" @onclick="() => RescanAsync(asset)">Reload</button>
                        <button type="button" disabled="@_busy" @onclick="() => _rebuildKey = Key(asset)">Rebuild...</button>
                        <button type="button" disabled="@_busy" @onclick="() => _removeKey = Key(asset)">Remove...</button>
                    }
                </div>
                </details>
            </article>
        }
        }
    }
</section>

@code {
    // The sources TradeViewer can chart (AS2); yahoo and tradingview follow with stocks, ETFs and forex.
    private static readonly string[] Sources = { "binance" };

    /// <summary>The search waits this long after the last key, so typing a word asks the server once (AS2).</summary>
    private static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(250);

    private readonly Dictionary<string, HistoryEdit> _edit = new Dictionary<string, HistoryEdit>();
    private SymbolSearchResponse? _symbols;
    private SymbolDetailsResponse? _details;
    private CancellationTokenSource? _typing;
    // The five fixed watchlists, one per asset class (AS1).
    private static readonly (string Code, string Title)[] Lists =
    {
        ("crypto", "Crypto"), ("stock", "Stocks"), ("etf", "ETFs"), ("forex", "Forex"), ("commodity", "Commodities")
    };

    private string? _dragKey;
    private string? _dropKey;
    private List<AssetResponse>? _assets;
    private string _source = Sources[0];
    private string _search = string.Empty;
    private string? _editKey;
    private string? _removeKey;
    private string? _rebuildKey;
    private string? _message;
    private bool _failed;
    private bool _busy;
    private bool _reloadPending;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        Events.AssetStatusChanged += OnAssetStatusChanged;
        Events.Reconnected += OnReconnected;
        _ = Events.StartAsync();

        await SearchAsync();
        await LoadAssetsAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        Events.AssetStatusChanged -= OnAssetStatusChanged;
        Events.Reconnected -= OnReconnected;
    }

    private void OnAssetStatusChanged(string source, string symbol)
    {
        ScheduleReload();
    }

    private void OnReconnected()
    {
        ScheduleReload();
    }

    /// <summary>An import raises many events in a row; the list is read once for all of them.</summary>
    private void ScheduleReload()
    {
        if (_reloadPending || _disposed)
        {
            return;
        }

        _reloadPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(300);
            _reloadPending = false;
            if (_disposed)
            {
                return;
            }

            await LoadAssetsAsync();
            await SearchAsync();
            StateHasChanged();
        });
    }

    /// <summary>Searches 250 ms after the last key; a key pressed meanwhile starts the wait again.</summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _typing?.Cancel();
        _typing = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDelay, _typing.Token);
        }
        catch (TaskCanceledException)
        {
            return; // the user typed on
        }

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var wanted = _search;
        var source = _source;
        var result = await Api.GetSymbolsAsync(source, wanted);
        if (wanted != _search || source != _source)
        {
            return; // the user typed on; a newer search is on its way
        }

        if (result.Error != null)
        {
            Show(result.Error, true);
        }

        _symbols = result.Value ?? new SymbolSearchResponse(Array.Empty<SymbolResponse>(), 0, false, false);
    }

    /// <summary>A symbol chosen: the Downloader looks it up, which is the check that it can be added (AS2).</summary>
    private async Task ChooseAsync(SymbolResponse symbol)
    {
        _busy = true;
        var result = await Api.GetSymbolDetailsAsync(symbol.Source, symbol.SourceSymbol ?? symbol.Symbol);
        _busy = false;
        _details = result.Value;
        if (result.Error != null)
        {
            Show(result.Error, true);
        }
        else
        {
            _message = null;
        }
    }

    private async Task AddChosenAsync()
    {
        var chosen = _details!;
        var added = await RunAsync(
            async () => (await Api.AddAsync(chosen.Source, chosen.Symbol, chosen.SourceSymbol == chosen.Symbol ? null : chosen.SourceSymbol)).Error,
            chosen.DisplayName + " added. Its history is loading.");
        if (added)
        {
            _details = null;
        }
    }

    /// <summary>The trading hours as the lookup gives them: around the clock, an exchange session, or forex.</summary>
    private static string SessionText(SymbolDetailsResponse details)
    {
        switch (details.Session)
        {
            case "continuous":
                return "around the clock (" + details.TimeZone + ")";
            case "exchange":
                return details.Open + " to " + details.Close + " " + details.TimeZone;
            case "newYorkClose":
                return "forex, the day ends 17:00 New York";
            default:
                return details.Session;
        }
    }

    private async Task LoadAssetsAsync()
    {
        var result = await Api.GetAssetsAsync();
        if (result.Error != null)
        {
            Show(result.Error, true);
        }

        // While the user edits, the rows keep their place; only the figures change.
        _assets = result.Value ?? _assets ?? new List<AssetResponse>();
    }

    private Task RescanAsync(AssetResponse asset)
    {
        return RunAsync(() => Api.RescanAsync(asset.Source, asset.Symbol), "Reloading the files of " + asset.DisplayName + ".");
    }

    private Task RebuildAsync(AssetResponse asset)
    {
        _rebuildKey = null;
        return RunAsync(() => Api.RebuildAsync(asset.Source, asset.Symbol), "Rebuilding the candles of " + asset.DisplayName + ".");
    }

    private Task RemoveAsync(AssetResponse asset)
    {
        _removeKey = null;
        return RunAsync(() => Api.RemoveAsync(asset.Source, asset.Symbol), asset.DisplayName + " removed.");
    }

    private void EditHistory(AssetResponse asset)
    {
        _edit.Clear();
        foreach (var timeframe in asset.Timeframes)
        {
            _edit[timeframe.Timeframe] = new HistoryEdit
            {
                Complete = timeframe.HistoryFrom == null,
                From = timeframe.HistoryFrom == null
                    ? DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-90)
                    : DateOnly.ParseExact(timeframe.HistoryFrom, "yyyy-MM-dd", CultureInfo.InvariantCulture)
            };
        }

        _editKey = Key(asset);
        _removeKey = null;
        _rebuildKey = null;
    }

    private async Task SaveHistoryAsync(AssetResponse asset)
    {
        var history = new Dictionary<string, string?>();
        foreach (var pair in _edit)
        {
            history[pair.Key] = pair.Value.Complete ? null : pair.Value.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }

        var saved = await RunAsync(
            async () => (await Api.ChangeHistoryAsync(asset.Source, asset.Symbol, history)).Error,
            "History of " + asset.DisplayName + " changed.");
        if (saved)
        {
            _editKey = null;
        }
    }

    /// <returns>True when the command worked.</returns>
    private async Task<bool> RunAsync(Func<Task<string?>> command, string done)
    {
        _busy = true;
        _message = null;
        try
        {
            var error = await command();
            Show(error ?? done, error != null);
            await LoadAssetsAsync();
            await SearchAsync();
            return error == null;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Show(string message, bool failed)
    {
        _message = message;
        _failed = failed;
    }

    /// <summary>The chart of the asset in its largest timeframe below a week that has candles.</summary>
    private static string ChartAddress(AssetResponse asset)
    {
        var chartable = asset.Timeframes.Where(timeframe => timeframe.Chartable).ToList();
        var timeframe = chartable.LastOrDefault(item => item.Timeframe != "1w") ?? chartable[chartable.Count - 1];
        return Chart.Address(asset.Source, asset.Symbol, timeframe.Timeframe);
    }

    private void StartDrag(AssetResponse asset)
    {
        _dragKey = Key(asset);
    }

    private void EnterDrop(AssetResponse asset)
    {
        // Only a place in the same watchlist can take the asset.
        var dragged = _assets?.FirstOrDefault(item => Key(item) == _dragKey);
        _dropKey = dragged != null && dragged.AssetClass == asset.AssetClass ? Key(asset) : null;
    }

    private void EndDrag()
    {
        _dragKey = null;
        _dropKey = null;
    }

    /// <summary>The dragged asset takes the place of the one it is dropped on.</summary>
    private async Task DropOnAsync(AssetResponse target)
    {
        var dragged = _assets?.FirstOrDefault(item => Key(item) == _dragKey);
        EndDrag();
        if (dragged == null || dragged.AssetClass != target.AssetClass || Key(dragged) == Key(target))
        {
            return;
        }

        var inList = _assets!.Where(item => item.AssetClass == target.AssetClass).ToList();
        await MoveAsync(dragged, inList.IndexOf(target));
    }

    /// <summary>Puts the asset at another place of its watchlist and saves the new order as a whole (AS1).</summary>
    private async Task MoveAsync(AssetResponse asset, int newIndex)
    {
        var inList = _assets!.Where(item => item.AssetClass == asset.AssetClass).ToList();
        if (newIndex < 0 || newIndex >= inList.Count)
        {
            return;
        }

        inList.Remove(asset);
        inList.Insert(newIndex, asset);
        var order = inList.Select(item => new WatchlistEntry(item.Source, item.Symbol)).ToList();

        _busy = true;
        try
        {
            var error = await Watchlists.ReorderAsync(asset.AssetClass, order);
            if (error != null)
            {
                Show(error, true);
            }

            await LoadAssetsAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Key(AssetResponse asset)
    {
        return asset.Source + "/" + asset.Symbol;
    }

    /// <summary>The gaps the source confirmed within the asset's history, over all its timeframes (MD4).</summary>
    private static int GapsOf(AssetResponse asset)
    {
        return asset.Timeframes.Sum(timeframe => timeframe.Gaps.Count);
    }

    private static string GapText(GapResponse gap)
    {
        return TimeText(DateTimeOffset.FromUnixTimeSeconds(gap.From)) + " to " + TimeText(DateTimeOffset.FromUnixTimeSeconds(gap.To)) + " UTC";
    }

    private static string TimeText(DateTimeOffset? time)
    {
        return time == null ? "-" : time.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private sealed class HistoryEdit
    {
        public bool Complete { get; set; }

        public DateOnly From { get; set; }
    }
}
