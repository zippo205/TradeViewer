@page "/scenarios/expert"
@page "/scenarios/expert/{Id}"
@implements IDisposable
@inject ScenariosApi Api
@inject AssetsApi AssetsClient
@inject DrawingsApi DrawingsClient
@inject WorkspaceApi Workspace
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The scenario editor (SC1-SC16, SC20, SC21; decisions 0010 to 0012): the list, the chart of a scenario on its
   levels, previous and next, the asset and history it needs, and editing: a new scenario (SC9), the point tools of
   the level shown (SC10), the panel (SC12), saving in the background once the user changed something (SC13), the id
   at the first save (SC14), the problems at their fields (SC15), delete (SC16), undo and redo. Opening and stepping
   through the scenarios writes nothing. *@

<PageTitle>@(Id ?? "Expert scenarios") - TradeViewer</PageTitle>

<NavigationLock ConfirmExternalNavigation="@Unprotected" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<ScenarioChart @bind-ListOpen="_listOpen">
    <Toolbar>
        <strong class="chart-title">Expert scenarios</strong>
        <div class="segments" role="group" aria-label="Step through the list">
            <button type="button" title="The scenario before this one in the list" disabled="@(_list.Step(Id, -1) == null)" @onclick="() => Step(-1)">‹ Previous</button>
            <button type="button" title="The scenario after this one in the list" disabled="@(_list.Step(Id, +1) == null)" @onclick="() => Step(+1)">Next ›</button>
        </div>
        @if (_session != null)
        {
            <ScenarioLevelBar View="@_levels" OnChanged="LevelsChangedAsync" />
            <label title="Logarithmic price scale; the levels of a scenario are measured in log scale (SC3)">
                <input type="checkbox" checked="@_logScale" @onchange="e => _logScale = (bool)e.Value!" /> log
            </label>
            @if (Writable && _asset != null && !Downloading && _missing == null)
            {
                <ScenarioPointTools Tools="@Tools" Active="@_tool" Level="@_levels.Shown" OnChoose="ChooseToolAsync" />
            }
        }
        @if (_asset?.Loading == true)
        {
            <span class="badge loading">loading</span>
        }
    </Toolbar>

    <Chart>
        @if (_creating)
        {
            <NewScenarioDialog Choices="@_assets" Source="@(_preset?.Source ?? _session?.Scenario.Source)" Symbol="@(_preset?.Symbol ?? _session?.Scenario.Symbol)"
                               Context="@_preset?.Context" From="@_preset?.From" To="@_preset?.To" Problem="@_createProblem"
                               OnCreate="CreateAsync" OnCancel="() => { _creating = false; _createProblem = null; _preset = null; }" />
        }
        @if (_status != null && !_status.Enabled)
        {
            <p class="chart-note">No scenario folder is configured (Scenarios:RootPath, see the runbook).</p>
        }
        else if (_openError != null)
        {
            <p class="status-bad chart-note">@_openError</p>
        }
        else if (_session == null)
        {
            <p class="chart-note muted">@(Id == null ? "Choose a scenario from the list, or make a new one." : "Loading...")</p>
        }
        else if (_asset == null)
        {
            <div class="chart-note scenario-notice">
                <p>@_session.Scenario.Source/@_session.Scenario.Symbol is not one of your assets, so its chart cannot be shown (SC6).</p>
                <button type="button" disabled="@_busy" @onclick="AddAssetAsync">Add @_session.Scenario.Symbol</button>
                @if (_actionProblem != null)
                {
                    <span class="status-bad">@_actionProblem</span>
                }
            </div>
        }
        else
        {
            @if (_actionProblem != null)
            {
                <div class="scenario-notice">
                    <span class="status-bad">The history of @_asset.Symbol could not be loaded: @_actionProblem</span>
                    <button type="button" disabled="@_busy" @onclick="LoadHistoryAsync">Try again</button>
                </div>
            }
            @if (_missing != null)
            {
                <div class="scenario-notice">
                    <span class="status-bad">Candles of the span are missing, so this scenario cannot be edited: @_missing</span>
                </div>
            }
            @if (SelectionText != null && Writable)
            {
                <div class="scenario-selection" role="toolbar" aria-label="Selected">
                    <span>@SelectionText</span>
                    <button type="button" class="danger" title="Remove it (Delete); undo brings it back" @onclick="DeleteSelectionAsync">Delete</button>
                </div>
            }
            @if (_editProblem != null)
            {
                <div class="scenario-notice">
                    <span class="status-bad">@_editProblem</span>
                    <button type="button" class="link-button" title="Dismiss" @onclick="() => _editProblem = null">✕</button>
                </div>
            }
            @if (Chartable)
            {
                <div class="chart-with-tools">
                @* SC20: the tool rail of the chart page on every level; what is drawn belongs to the level shown. *@
                @if (Writable && !Downloading && _missing == null)
                {
                    <DrawingToolbar Tool="@_tools.Tool" Magnet="@_magnet" Hidden="@_drawingsHidden"
                                    CanUndo="@(_session.CanUndo)" CanRedo="@(_session.CanRedo)"
                                    Pattern="@_tools.Pattern" LastPattern="@_tools.LastPattern" OnPattern="ChoosePatternAsync"
                                    OnTool="ChooseDrawingToolAsync" OnMagnet="SetMagnetAsync" OnHidden="SetDrawingsHiddenAsync"
                                    OnUndo="UndoAsync" OnRedo="RedoAsync" />
                }
                <div class="chart-canvas-area">
                <ChartHost @ref="_chart"
                           Source="@_asset.Source"
                           Symbol="@_asset.Symbol"
                           Timeframe="@(_levels.Timeframe ?? "")"
                           TickSize="@_asset.TickSize"
                           Timeframes="@ChartableTimeframes"
                           LogScale="@_logScale"
                           KeepCentreOnTimeframeChange="true"
                           Window="@SpanWindow"
                           OnReady="OnChartReadyAsync"
                           OnPointPlaced="OnPointPlacedAsync"
                           OnPointSelected="OnPointSelected"
                           OnOverlayClicked="OnOverlayClicked"
                           OnScenarioToolChanged="OnScenarioToolChanged"
                           OnDrawingCreated="OnDrawingCreatedAsync"
                           OnDrawingChanged="OnDrawingChangedAsync"
                           OnSelectionChanged="OnDrawingSelectedAsync"
                           OnToolChanged="OnDrawingToolChanged"
                           OnKey="OnKeyAsync" />
                @if (SelectedDrawing is { } drawing && Writable)
                {
                    <DrawingBar Drawing="@ScenarioDrawings.ToBar(drawing, _session.Scenario.Source, _session.Scenario.Symbol)" Wave="@((_tools.WaveDegree, _tools.WaveLabel))"
                                OnEdit="edited => EditDrawingAsync(edited, drawing.Level)" OnDelete="() => RemoveDrawingAsync(drawing.Id)" />
                }
                @if (_tools.ChoosesWave)
                {
                    <WaveChooser Degree="@_tools.WaveDegree" Label="@_tools.WaveLabel" Pattern="@WavePatterns.Find(_tools.Pattern)" OnChanged="OnWaveChosenAsync" />
                }
                @if (DrawingToolChoice.KindOf(_tools.Tool) is string kind)
                {
                    <FibonacciChooser Presets="@_tools.PresetsOf(kind)" Selected="@(_tools.PresetOf(kind)?.Id ?? Guid.Empty)" OnChanged="id => OnPresetChosenAsync(kind, id)" />
                }
                </div>
                </div>
            }
            else if (!Downloading)
            {
                <p class="chart-note">@_asset.Symbol has no candles in @_levels.Timeframe yet.</p>
            }
            @if (Downloading)
            {
                <div class="scenario-loading" role="status">
                    <strong>Data is downloading</strong>
                    @if (_session.Response.Asset.HistoryNeeded.Count > 0)
                    {
                        <span class="muted">@_asset.Symbol @HistoryText(_session.Response.Asset.HistoryNeeded)</span>
                    }
                </div>
            }
        }
    </Chart>

    <List>
        <ExpertScenarioList View="@_list" Selected="@Id" ReadAt="@_readAt" Problem="@_listProblem"
                            OnSelect="Open" OnReload="ReadListAsync" OnChanged="StateHasChanged" />
    </List>

    <Panel>
        <ExpertScenarioPanel Response="@_session?.Response" ReadOnly="@(!Writable)" SelectedPoint="@_selectedPoint"
                             SaveText="@SaveText" SaveBad="@(_queue.Problem != null)" CanSave="@CanSave" SaveTitle="@SaveTitle"
                             OnChange="ChangeAsync" OnWave1Pattern="ChangeWave1PatternAsync" OnSelectPoint="SelectPointAsync" OnDelete="DeleteAsync" OnSave="Save" />
    </Panel>
</ScenarioChart>

@code {
    private static readonly TimeSpan ListInterval = TimeSpan.FromSeconds(30);

    private readonly ExpertScenarioListView _list = new ExpertScenarioListView();
    private readonly ScenarioLevelView _levels = new ScenarioLevelView();

    /// <summary>One change at a time: a snap, a field, undo or redo each start from the scenario the one before left.</summary>
    private readonly SemaphoreSlim _edits = new SemaphoreSlim(1, 1);

    private ExpertScenarioSaveQueue _queue = null!;
    private ScenariosStatusResponse? _status;
    private ExpertScenarioSession? _session;
    private AssetResponse? _asset;
    private IReadOnlyList<AssetResponse> _assets = Array.Empty<AssetResponse>();
    private ChartHost? _chart;
    private Timer? _timer;
    private DateTimeOffset? _readAt;
    private string? _listProblem;
    private string? _openError;
    private string? _actionProblem;
    private string? _editProblem;
    private string? _createProblem;
    private string? _opened;
    private string? _tool;
    private string? _selectedPoint;
    private string? _selectedGroup;
    private string? _selectedShape;
    private bool _listOpen = true;
    private bool _logScale = true;
    private bool _busy;
    private bool _creating;
    private bool _showSpan;
    private bool _leaveConfirmed;
    private string? _historyLoaded;
    private NewScenarioPreset? _preset;
    private string? _missing;

    // SC20: the free drawings of the scenario, with the tool rail of the chart page.
    private readonly DrawingToolChoice _tools = new DrawingToolChoice();
    private bool _magnet = true;
    private bool _drawingsHidden;
    private Guid? _selectedDrawing;
    private bool _disposed;

    [Parameter]
    public string? Id { get; set; }

    private bool Writable => _status?.Writable == true;

    /// <summary>SC6: the history the span needs is on its way (or was asked for and not loaded yet).</summary>
    private bool Downloading => _session != null && _asset != null && _actionProblem == null && (_busy || _asset.Loading || _session.Response.Asset.HistoryNeeded.Count > 0);

    /// <summary>SC2: the scenario chart shows only the candles of the span.</summary>
    private (DateTimeOffset From, DateTimeOffset To)? SpanWindow
    {
        get
        {
            var scenario = _session?.Scenario;
            if (scenario?.From == null)
            {
                return null;
            }

            var to = scenario.To ?? DateTimeOffset.UtcNow;
            return to > scenario.From.Value ? (scenario.From.Value, to) : null;
        }
    }

    private bool Chartable => _asset != null && _levels.Timeframe != null && _asset.Timeframes.Any(timeframe => timeframe.Timeframe == _levels.Timeframe && timeframe.Chartable);

    private IReadOnlyList<string> ChartableTimeframes => _asset?.Timeframes.Where(timeframe => timeframe.Chartable).Select(timeframe => timeframe.Timeframe).ToList() ?? new List<string>();

    private IReadOnlyList<ScenarioPointTool> Tools => _session == null ? Array.Empty<ScenarioPointTool>() : ScenarioPoints.ToolsOf(_levels.Shown, _session.Scenario);

    /// <summary>A new scenario that cannot be saved yet, because wave 2 end is missing (SC14).</summary>
    private bool WaitsForWave2End => _session != null && _session.WaitsForWave2End && _queue.IdOf(_session.Key) == null;

    /// <summary>Leaving now would lose a change: one not saved, or a save still on its way.</summary>
    private bool Unprotected => _session?.Dirty == true || _queue.HasUnsaved;

    /// <summary>SC13: Save is enabled while there is an unsaved change that can be written.</summary>
    private bool CanSave => _session != null && Writable && _session.Dirty && !WaitsForWave2End && !Misfit && !_queue.IsUnsaved(_session.Key) && !Downloading;

    /// <summary>Decision 0013: the levels do not fit; Save stays disabled until the user corrects it.</summary>
    private bool Misfit => _session?.Response.Problems.Any(problem => problem.Blocking) == true;

    private string SaveTitle
    {
        get
        {
            if (_session == null || !_session.Dirty)
            {
                return "Nothing to save";
            }

            if (WaitsForWave2End)
            {
                return "Place wave 2 end first: the id of the scenario needs its month (SC14)";
            }

            return Misfit ? "The levels do not fit: correct the points marked in the panel first" : "Save the scenario into its file";
        }
    }

    private string? SaveText
    {
        get
        {
            if (_session == null)
            {
                return null;
            }

            if (!Writable)
            {
                return "read only: the scenario folder cannot be written";
            }

            if (_queue.Problem != null)
            {
                return _queue.Problem;
            }

            if (_queue.IsUnsaved(_session.Key))
            {
                return "saving...";
            }

            if (_session.Dirty)
            {
                return WaitsForWave2End ? "unsaved changes: Save needs wave 2 end (the id needs its month)"
                    : Misfit ? "unsaved changes: the levels do not fit, correct them to save"
                    : "unsaved changes";
            }

            return _session.Changed ? "saved" : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _queue = new ExpertScenarioSaveQueue(Api);
        _queue.StateChanged += OnQueueChanged;
        _queue.Saved += OnSaved;

        var status = await Api.GetStatusAsync();
        _status = status.Value;

        // The magnet is one setting for all charts (DR2); a new Fibonacci drawing copies the levels of its preset (DR4).
        var settings = await Workspace.GetSettingsAsync();
        _magnet = settings.Value?.Magnet ?? true;
        var presets = await DrawingsClient.GetPresetsAsync();
        _tools.Presets = presets.Value ?? new List<FibonacciPresetRecord>();
        if (_status?.Enabled == true)
        {
            await ReadListAsync();
            _timer = new Timer(_ => _ = InvokeAsync(ReadListAsync), null, ListInterval, ListInterval);
            await OpenPresetAsync();
        }
    }

    /// <summary>What the dialog of a new scenario starts with when the chart page sent a range (SC22).</summary>
    private sealed record NewScenarioPreset(string? Source, string? Symbol, string? Context, DateTime? From, DateTime? To);

    /// <summary>
    /// SC22: /scenarios/expert?new&amp;source=&amp;symbol=&amp;context=&amp;from=&amp;to= opens the dialog of a new scenario with
    /// these values. The query is read once and taken from the address, so reloading the page does not open it again.
    /// </summary>
    private async Task OpenPresetAsync()
    {
        var address = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = address.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .GroupBy(pair => Uri.UnescapeDataString(pair[0]), StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => group.First().Length > 1 ? Uri.UnescapeDataString(group.First()[1]) : "", StringComparer.Ordinal);
        if (Id != null || !query.ContainsKey("new"))
        {
            return;
        }

        string? Text(string key) => query.TryGetValue(key, out var value) && value.Length > 0 ? value : null;
        DateTime? Day(string key) => DateTime.TryParseExact(Text(key), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) ? day : null;
        Navigation.NavigateTo("scenarios/expert", replace: true);
        if (!Writable)
        {
            return;
        }

        _preset = new NewScenarioPreset(Text("source"), Text("symbol"), Text("context"), Day("from"), Day("to"));
        await OpenNewAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _opened && _status?.Enabled == true)
        {
            _opened = Id;
            await OpenAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showSpan && _chart?.IsReady == true)
        {
            _showSpan = false;
            await ShowScenarioAsync(positionOnSpan: true);
        }
    }

    /// <summary>SC5: the folder is read on every call; the server reads only the files that changed.</summary>
    private async Task ReadListAsync()
    {
        if (_disposed)
        {
            return;
        }

        var list = await Api.ListAsync();
        _listProblem = list.Error;
        if (list.Value != null)
        {
            _list.Set(list.Value);
            _readAt = DateTimeOffset.UtcNow;
        }

        StateHasChanged();
    }

    private async Task OpenAsync()
    {
        _session = null;
        _missing = null;
        _openError = null;
        _actionProblem = null;
        _editProblem = null;
        _tool = null;
        _selectedPoint = null;
        if (Id == null)
        {
            return;
        }

        var response = await Api.GetAsync(Id);
        if (response.Value == null)
        {
            _openError = response.Error;
            return;
        }

        // A change of this scenario the server has not confirmed yet wins over the file (WS1, priority 1).
        var unsent = _queue.UnsentOf(Id);
        if (unsent != null)
        {
            var preview = await Api.PreviewAsync(unsent);
            response = preview.Value != null ? preview : response;
        }

        var key = _queue.KeyOf(Id);
        StartSession(key == null ? new ExpertScenarioSession(response.Value!) : new ExpertScenarioSession(key.Value, response.Value!));
        await ReadAssetAsync();
        LoadHistoryWhenNeeded();
    }

    private void StartSession(ExpertScenarioSession session)
    {
        _session = session;
        _missing = null;
        _levels.Open(session.Response.Levels);
        _showSpan = true;
        if (_chart?.IsReady == true)
        {
            StateHasChanged(); // the chart may need another timeframe first; the span follows after the render
        }
    }

    private async Task ReadAssetAsync()
    {
        var assets = await AssetsClient.GetAssetsAsync();
        _assets = assets.Value ?? (IReadOnlyList<AssetResponse>)Array.Empty<AssetResponse>();
        _asset = _assets.FirstOrDefault(asset => asset.Source == _session?.Scenario.Source && asset.Symbol == _session?.Scenario.Symbol);
    }

    private async Task OnChartReadyAsync()
    {
        if (_chart != null)
        {
            await _chart.SetDrawingOptionsAsync(_magnet, _drawingsHidden);
        }

        if (_session != null)
        {
            _showSpan = false;
            await ShowScenarioAsync(positionOnSpan: true);
        }
    }

    /// <summary>
    /// The shapes of the scenario with the groups hidden that the level shown does not show (SC21), the handles of the
    /// points of that level (SC10), and on opening the span (SC2).
    /// </summary>
    private async Task ShowScenarioAsync(bool positionOnSpan)
    {
        if (_chart == null || _session == null)
        {
            return;
        }

        var response = _session.Response;
        await _chart.SetOverlaysAsync(response.Groups, _levels.HiddenKeys(response.Groups));
        var handles = _levels.IsHidden(_levels.Shown) ? Array.Empty<ScenarioHandle>() : ScenarioPoints.HandlesOf(response.Scenario, _levels.Shown, Writable);
        await _chart.SetScenarioPointsAsync(handles);
        await _chart.SelectScenarioPointAsync(_selectedPoint);

        // SC20, SC21: the drawings of the levels shown; those of a higher level are seen, not moved.
        var drawings = (response.Scenario.Drawings ?? Array.Empty<ScenarioDrawingRecord>())
            .Where(drawing => _levels.IsVisible(drawing.Level))
            .Select(drawing => ScenarioDrawings.ToChart(drawing, Writable && drawing.Level == _levels.Shown))
            .ToList();
        if (SelectedDrawing == null)
        {
            _selectedDrawing = null;
        }

        await _chart.SetDrawingsAsync(drawings, _selectedDrawing?.ToString());

        // Decision 0013: the forms of the level shown are selected by a click and removed from the bar.
        var selectable = Writable ? response.Groups.Where(group => group.Level == _levels.Shown && _levels.IsVisible(group.Level)).Select(group => group.Key).ToList() : new List<string>();
        if (_selectedGroup != null && !selectable.Contains(_selectedGroup))
        {
            _selectedGroup = null;
        }

        await _chart.SetOverlaySelectableAsync(selectable);
        await _chart.SelectOverlayAsync(_selectedGroup, _selectedGroup == null ? null : _selectedShape);
        var scenario = response.Scenario;
        if (positionOnSpan && scenario.From != null)
        {
            await _chart.ShowTimeRangeAsync(scenario.From.Value, scenario.To ?? DateTimeOffset.UtcNow);
        }
    }

    private async Task LevelsChangedAsync()
    {
        // Another level offers other tools; the one in use goes back to the pointer.
        await ChooseToolAsync(null);
        await ChooseDrawingToolAsync(null);
        _selectedPoint = null;
        _selectedGroup = null;
        _selectedDrawing = null;
        StateHasChanged(); // another timeframe is a new series of the chart; the shapes stay, the groups follow the level
        await ShowScenarioAsync(positionOnSpan: false);
        await RefreshShapesAsync();
    }

    /// <summary>
    /// SC8, decision 0013: the shapes for the timeframe now shown, on which the points of the higher levels sit on the
    /// candles that made them. The scenario itself does not change.
    /// </summary>
    private async Task RefreshShapesAsync()
    {
        if (_session == null)
        {
            return;
        }

        await _edits.WaitAsync();
        try
        {
            var session = _session;
            var answer = session == null ? null : await Api.PreviewAsync(session.Scenario, _levels.Timeframe);
            if (session != null && answer?.Value != null && _session == session)
            {
                session.Refresh(answer.Value);
                await ShowScenarioAsync(positionOnSpan: false);
            }
        }
        finally
        {
            _edits.Release();
        }

        StateHasChanged();
    }

    private async Task ChooseToolAsync(ScenarioPointTool? tool)
    {
        _tool = tool?.Tool.Code;
        if (_chart != null)
        {
            await _chart.SetScenarioToolAsync(tool?.Tool);
        }
    }

    private void OnScenarioToolChanged(string? code)
    {
        _tool = code;
    }

    private async Task OnPointSelected(string? key)
    {
        _selectedPoint = key;
        if (key != null)
        {
            _selectedDrawing = null; // the module has put the drawing selection away itself
        }

        if (key != null && _selectedGroup != null && _chart != null)
        {
            _selectedGroup = null; // one thing is selected at a time
            await _chart.SelectOverlayAsync(null);
        }
    }

    /// <summary>Decision 0013: a click on a form selects it; on a marker of the trade, that point.</summary>
    private async Task OnOverlayClicked((string? Group, string? Key) clicked)
    {
        if (clicked.Group != null && _selectedDrawing != null && _chart != null)
        {
            _selectedDrawing = null; // one thing is selected at a time
            await ShowScenarioAsync(positionOnSpan: false);
        }

        if (clicked.Key != null)
        {
            _selectedGroup = clicked.Group;
            _selectedShape = clicked.Key;
            _selectedPoint = clicked.Key;
        }
        else
        {
            _selectedGroup = clicked.Group;
            _selectedShape = null;
            _selectedPoint = null;
        }

        if (_chart != null)
        {
            await _chart.SelectScenarioPointAsync(_selectedPoint);
        }
    }

    /// <summary>The selected free drawing, when it still exists.</summary>
    private ScenarioDrawingRecord? SelectedDrawing => _session == null ? null : ScenarioDrawings.Find(_session.Scenario, _selectedDrawing);

    /// <summary>SC20: a drawing placed on the chart belongs to the level shown.</summary>
    private async Task OnDrawingCreatedAsync(ChartDrawing drawing)
    {
        var record = ScenarioDrawings.ToRecord(drawing, _levels.Shown);
        if (record == null)
        {
            return;
        }

        // A wave label placed: the chooser moves on to the next label, and the tool, still in use, places that one.
        if (_tools.Created(record.Tool, record.Wave) && _chart != null)
        {
            await _chart.SetToolAsync("waveLabel", _tools.ExtrasFor("waveLabel"));
        }

        await EditAsync(scenario => Api.PreviewAsync(ScenarioDrawings.With(scenario, record), _levels.Timeframe));
    }

    /// <summary>A drawing moved or reshaped; it keeps its level. One of another level is locked and is not changed here.</summary>
    private Task OnDrawingChangedAsync(ChartDrawing drawing)
    {
        var existing = _session == null || !Guid.TryParse(drawing.Id, out var id) ? null : ScenarioDrawings.Find(_session.Scenario, id);
        var record = existing == null || existing.Level != _levels.Shown ? null : ScenarioDrawings.ToRecord(drawing, existing.Level);
        return record == null ? Task.CompletedTask : EditAsync(scenario => Api.PreviewAsync(ScenarioDrawings.With(scenario, record), _levels.Timeframe));
    }

    private async Task OnDrawingSelectedAsync(string? id)
    {
        _selectedDrawing = Guid.TryParse(id, out var selected) ? selected : null;
        if (_selectedDrawing != null && _chart != null)
        {
            _selectedPoint = null; // one thing is selected at a time
            _selectedGroup = null;
            await _chart.SelectOverlayAsync(null);
        }
    }

    private Task EditDrawingAsync(DrawingRecord edited, string level)
    {
        var record = ScenarioDrawings.FromBar(edited, level);
        return EditAsync(scenario => Api.PreviewAsync(ScenarioDrawings.With(scenario, record), _levels.Timeframe));
    }

    private Task RemoveDrawingAsync(Guid id)
    {
        _selectedDrawing = null;
        return EditAsync(scenario => Api.PreviewAsync(ScenarioDrawings.Without(scenario, id), _levels.Timeframe));
    }

    private async Task ChooseDrawingToolAsync(string? tool)
    {
        tool = _tools.ChooseTool(tool);
        if (_chart != null)
        {
            await _chart.SetToolAsync(tool, _tools.ExtrasFor(tool)); // the chart answers with ToolChanged
        }
    }

    private async Task ChoosePatternAsync(string code)
    {
        var tool = _tools.ChoosePattern(code);
        if (_chart != null)
        {
            await _chart.SetToolAsync(tool, _tools.ExtrasFor(tool));
        }
    }

    private void OnDrawingToolChanged(string? tool)
    {
        _tools.ToolChanged(tool);
        if (tool != null)
        {
            _tool = null; // the module put the point tool away
        }
    }

    private async Task OnWaveChosenAsync((string Degree, string Label) wave)
    {
        if (_tools.ChooseWave(wave.Degree, wave.Label) && _chart != null)
        {
            await _chart.SetToolAsync(_tools.Tool, _tools.ExtrasFor(_tools.Tool));
        }
    }

    private async Task OnPresetChosenAsync(string kind, Guid id)
    {
        if (_tools.ChoosePreset(kind, id) && _chart != null)
        {
            await _chart.SetToolAsync(_tools.Tool, _tools.ExtrasFor(_tools.Tool));
        }
    }

    /// <summary>The magnet is one setting for all charts (DR2).</summary>
    private async Task SetMagnetAsync(bool magnet)
    {
        _magnet = magnet;
        if (_chart != null)
        {
            await _chart.SetDrawingOptionsAsync(_magnet, _drawingsHidden);
        }

        _ = Workspace.SaveMagnetAsync(magnet);
    }

    /// <summary>All free drawings hidden or shown on this page; the levels hide theirs with their switches (SC21).</summary>
    private async Task SetDrawingsHiddenAsync(bool hidden)
    {
        _drawingsHidden = hidden;
        if (_chart != null)
        {
            await _chart.SetDrawingOptionsAsync(_magnet, _drawingsHidden);
        }
    }

    /// <summary>What the bar above the chart names as selected, null when nothing is.</summary>
    private string? SelectionText
    {
        get
        {
            if (_session == null)
            {
                return null;
            }

            if (_selectedPoint != null)
            {
                return ScenarioPoints.EntriesOf(_session.Scenario).FirstOrDefault(entry => entry.Key == _selectedPoint)?.Label;
            }

            return _selectedGroup == null ? null : _session.Response.Groups.FirstOrDefault(group => group.Key == _selectedGroup)?.Title;
        }
    }

    /// <summary>Delete of the bar or the key: the selected point, else the selected form.</summary>
    private Task DeleteSelectionAsync()
    {
        if (SelectedDrawing is { } drawing && drawing.Level == _levels.Shown)
        {
            return RemoveDrawingAsync(drawing.Id);
        }

        if (_selectedPoint != null)
        {
            return RemoveSelectedPointAsync();
        }

        var group = _selectedGroup;
        if (group == null)
        {
            return Task.CompletedTask;
        }

        _selectedGroup = null;
        _selectedShape = null;
        return EditAsync(scenario => Api.PreviewAsync(ScenarioPoints.RemoveGroup(scenario, group), _levels.Timeframe));
    }

    private async Task SelectPointAsync(string key)
    {
        _selectedPoint = key;
        if (_chart != null)
        {
            await _chart.SelectScenarioPointAsync(key);
        }
    }

    /// <summary>A point placed with a tool or let go after a drag: the server snaps it on its timeframe (SC10).</summary>
    private Task OnPointPlacedAsync(PlacedPoint point)
    {
        var time = DateTimeOffset.FromUnixTimeSeconds(point.Time);
        return EditAsync(scenario => Api.SnapAsync(new SnapScenarioPointRequest(scenario, point.Field, time, point.Price, point.Index, point.Kind), _levels.Timeframe));
    }

    /// <summary>A field of the panel (SC12).</summary>
    private Task ChangeAsync(ExpertScenarioRecord changed)
    {
        return EditAsync(_ => Api.PreviewAsync(changed, _levels.Timeframe));
    }

    /// <summary>Proposal 9: choosing the other pattern of wave 1 removes the points of the first after a confirmation; undo brings them back.</summary>
    private async Task ChangeWave1PatternAsync(string? pattern)
    {
        if (_session == null)
        {
            return;
        }

        var dropped = ScenarioPoints.Wave1PointsDroppedBy(_session.Scenario, pattern);
        if (dropped > 0 && !await JS.InvokeAsync<bool>("confirm", "A " + pattern + " has other points: " + dropped + " point(s) of wave 1 are removed. Go on?"))
        {
            StateHasChanged(); // the select shows the pattern of the scenario again
            return;
        }

        var setup = _session.Response.Levels.FirstOrDefault(level => level.Level == ScenarioPoints.Setup)?.Timeframe ?? "";
        await EditAsync(scenario => Api.PreviewAsync(ScenarioPoints.WithWave1Pattern(scenario, pattern, setup), _levels.Timeframe));
    }

    private Task RemoveSelectedPointAsync()
    {
        var key = _selectedPoint;
        if (key == null)
        {
            return Task.CompletedTask;
        }

        _selectedPoint = null;
        _selectedGroup = null;
        _selectedShape = null;
        return EditAsync(scenario => Api.PreviewAsync(ScenarioPoints.Remove(scenario, key), _levels.Timeframe));
    }

    /// <summary>
    /// Runs one change of the scenario: the server answers with the scenario, its shapes and its problems, the chart
    /// shows them and the queue saves them. A change the server refuses (no candle there) leaves the scenario as it
    /// was and puts the handles back.
    /// </summary>
    private async Task EditAsync(Func<ExpertScenarioRecord, Task<ApiResult<ExpertScenarioResponse>>> change)
    {
        if (_session == null || !Writable)
        {
            return;
        }

        await _edits.WaitAsync();
        try
        {
            var session = _session;
            if (session == null)
            {
                return;
            }

            var answer = await change(session.Scenario);
            if (_session != session)
            {
                return; // another scenario was opened meanwhile
            }

            if (answer.Value == null)
            {
                _editProblem = answer.Error;
            }
            else
            {
                _editProblem = null;
                session.Change(answer.Value);
            }

            await ShowScenarioAsync(positionOnSpan: false);
        }
        finally
        {
            _edits.Release();
        }

        LoadHistoryWhenNeeded(); // the span may have been moved back
        StateHasChanged();
    }

    private async Task UndoAsync()
    {
        await StepHistoryAsync(undo: true);
    }

    private async Task RedoAsync()
    {
        await StepHistoryAsync(undo: false);
    }

    private async Task StepHistoryAsync(bool undo)
    {
        if (_session == null || !Writable)
        {
            return;
        }

        await _edits.WaitAsync();
        try
        {
            var session = _session;
            var target = undo ? session?.UndoTarget() : session?.RedoTarget();
            if (session == null || target == null)
            {
                return;
            }

            var answer = await Api.PreviewAsync(target, _levels.Timeframe);
            if (_session != session)
            {
                return;
            }

            if (answer.Value == null)
            {
                _editProblem = answer.Error;
                return;
            }

            if (undo)
            {
                session.Undone(answer.Value);
            }
            else
            {
                session.Redone(answer.Value);
            }

            _selectedPoint = null;
            await ShowScenarioAsync(positionOnSpan: false);
        }
        finally
        {
            _edits.Release();
        }

        StateHasChanged();
    }

    /// <summary>SC13: the user saves; the queue sends it in the background and tries again when the server is not reachable.</summary>
    private void Save()
    {
        if (CanSave)
        {
            _queue.Put(_session!.Key, _session.Scenario);
        }
    }

    private void OnQueueChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>A save was confirmed: the first one gave the id, which becomes the address of the page (SC14).</summary>
    private void OnSaved(Guid key, ExpertScenarioRecord sent, ExpertScenarioRecord saved)
    {
        _ = InvokeAsync(async () =>
        {
            if (_session?.Key == key)
            {
                _session.Saved(sent, saved);
                if (Id == null && saved.Id != null)
                {
                    _opened = saved.Id;
                    _leaveConfirmed = true; // the same scenario under its new address
                    Navigation.NavigateTo("scenarios/expert/" + Uri.EscapeDataString(saved.Id), replace: true);
                }
            }

            await ReadListAsync();
        });
    }

    private async Task OnKeyAsync(string key)
    {
        switch (key)
        {
            case "delete":
                await DeleteSelectionAsync();
                break;
            case "undo":
                await UndoAsync();
                break;
            case "redo":
                await RedoAsync();
                break;
        }
    }

    private async Task OpenNewAsync()
    {
        var assets = await AssetsClient.GetAssetsAsync();
        _assets = assets.Value ?? (IReadOnlyList<AssetResponse>)Array.Empty<AssetResponse>();
        _createProblem = assets.Error;
        _creating = true;
    }

    /// <summary>SC9: the new scenario is shown at once; it is written only once wave 2 end is placed (SC14).</summary>
    private async Task CreateAsync(ExpertScenarioRecord scenario)
    {
        var answer = await Api.PreviewAsync(scenario);
        if (answer.Value == null)
        {
            _createProblem = answer.Error;
            return;
        }

        if (!await LeaveAllowedAsync())
        {
            return;
        }

        _creating = false;
        _createProblem = null;
        _preset = null;
        _opened = null;
        if (Id != null)
        {
            _leaveConfirmed = true;
            Navigation.NavigateTo("scenarios/expert");
        }

        _openError = null;
        _editProblem = null;
        _tool = null;
        _selectedPoint = null;
        StartSession(new ExpertScenarioSession(answer.Value));
        _asset = _assets.FirstOrDefault(asset => asset.Source == scenario.Source && asset.Symbol == scenario.Symbol);
        LoadHistoryWhenNeeded();
    }

    /// <summary>SC16: after a confirmation; a new scenario that was never saved is only dropped.</summary>
    private async Task DeleteAsync()
    {
        var session = _session;
        if (session == null)
        {
            return;
        }

        var id = session.Scenario.Id ?? _queue.IdOf(session.Key);
        if (!await JS.InvokeAsync<bool>("confirm", id == null ? "Drop this new scenario?" : "Delete the expert scenario " + id + "? Its file is removed."))
        {
            return;
        }

        await _queue.ForgetAsync(session.Key);
        if (id != null)
        {
            var problem = await Api.DeleteAsync(id);
            if (problem != null)
            {
                _editProblem = problem;
                return;
            }
        }

        var next = id == null ? null : _list.Step(id, +1) ?? _list.Step(id, -1);
        _session = null;
        _opened = null;
        await ReadListAsync();
        if (next != null && next != id)
        {
            Open(next);
        }
        else if (Id != null)
        {
            Navigation.NavigateTo("scenarios/expert");
        }
    }

    /// <summary>SC13: unsaved changes are lost when another scenario is opened or the page is left; the user is asked first.</summary>
    private async Task<bool> LeaveAllowedAsync()
    {
        if (_session?.Dirty == true)
        {
            return await JS.InvokeAsync<bool>("confirm", "The scenario has unsaved changes. Leave it without saving?");
        }

        return true;
    }

    private async Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        var target = Navigation.ToBaseRelativePath(Navigation.ToAbsoluteUri(context.TargetLocation).ToString()); // the target may be relative
        var stays = target.StartsWith("scenarios/expert", StringComparison.Ordinal);
        if (_leaveConfirmed)
        {
            _leaveConfirmed = false; // asked already by the action that navigates
            return;
        }

        if (!await LeaveAllowedAsync())
        {
            context.PreventNavigation();
            return;
        }

        if (!stays && _queue.HasUnsaved && !await JS.InvokeAsync<bool>("confirm", "A save is still on its way. Leave the page?"))
        {
            context.PreventNavigation();
        }
    }

    private void Open(string id)
    {
        Navigation.NavigateTo("scenarios/expert/" + Uri.EscapeDataString(id));
    }

    private void Step(int step)
    {
        var id = _list.Step(Id, step);
        if (id != null)
        {
            Open(id);
        }
    }

    /// <summary>SC6: the asset is added only when the user agrees.</summary>
    private async Task AddAssetAsync()
    {
        var scenario = _session!.Scenario;
        if (!await JS.InvokeAsync<bool>("confirm", "Add " + scenario.Symbol + " (" + scenario.Source + ") to your assets? Its history is then downloaded and imported."))
        {
            return;
        }

        await RunAsync(async () =>
        {
            var added = await AssetsClient.AddAsync(scenario.Source, scenario.Symbol);
            return added.Error;
        });
    }

    /// <summary>SC6: the history starts the span needs, as the server named them.</summary>
    private Task LoadHistoryAsync()
    {
        var session = _session!;
        return RunAsync(async () =>
        {
            var changed = await AssetsClient.ChangeHistoryAsync(session.Scenario.Source, session.Scenario.Symbol, session.Response.Asset.HistoryNeeded);
            return changed.Error;
        });
    }

    /// <summary>Runs an action on the asset, then waits until it has loaded and opens the scenario again.</summary>
    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _actionProblem = await action();
        if (_actionProblem == null)
        {
            for (var attempt = 0; attempt < 300 && !_disposed; attempt++)
            {
                await ReadAssetAsync();
                StateHasChanged();
                if (_asset != null && !_asset.Loading)
                {
                    break;
                }

                await Task.Delay(2000);
            }

            await ReopenAsync();
            if (_chart != null)
            {
                await _chart.ReloadSeriesAsync();
            }
        }

        _busy = false;
        LoadHistoryWhenNeeded(); // an asset just added may still need an older history
        StateHasChanged();
    }

    /// <summary>
    /// SC6: the history the span needs on the three levels is loaded without asking, once per need; a failure is shown
    /// with "Try again".
    /// </summary>
    private void LoadHistoryWhenNeeded()
    {
        var session = _session;
        if (session == null || _asset == null || _busy)
        {
            return;
        }

        if (session.Response.Asset.HistoryNeeded.Count == 0)
        {
            _ = InvokeAsync(CheckCoverageAsync); // loaded (or nothing to load): are the candles of the span there?
            return;
        }

        var need = session.Scenario.Source + "/" + session.Scenario.Symbol + ":" + HistoryText(session.Response.Asset.HistoryNeeded);
        if (need == _historyLoaded)
        {
            return;
        }

        _historyLoaded = need;
        _ = InvokeAsync(LoadHistoryAsync);
    }

    /// <summary>After the asset changed: the scenario as the user has it, with the asset state read again; its undo stays.</summary>
    private async Task ReopenAsync()
    {
        var session = _session;
        if (session == null)
        {
            return;
        }

        await _edits.WaitAsync(); // a change of the user meanwhile is not overwritten
        try
        {
            var answer = await Api.PreviewAsync(session.Scenario, _levels.Timeframe);
            if (answer.Value != null && _session == session)
            {
                session.Refresh(answer.Value);
                await ReadAssetAsync();
                _showSpan = true;
            }
        }
        finally
        {
            _edits.Release();
        }
    }

    /// <summary>
    /// SC6: once the history is loaded, the stored candles of the three levels must cover the span. If they do not, the
    /// scenario cannot be edited; a new one is not created and the page says why.
    /// </summary>
    private async Task CheckCoverageAsync()
    {
        var session = _session;
        var scenario = session?.Scenario;
        if (session == null || _asset == null || _asset.Loading || scenario?.From == null)
        {
            return;
        }

        var now = DateTimeOffset.UtcNow;
        var gaps = ScenarioCoverage.Missing(_asset, session.Response.Levels, scenario.From.Value, scenario.To ?? now, now);
        _missing = gaps.Count == 0 ? null : ScenarioCoverage.Text(gaps);
        if (_missing != null && scenario.Id == null && !session.Changed && _session == session)
        {
            await JS.InvokeVoidAsync("alert", "No scenario can be created: candles of the span are missing. " + _missing);
            _session = null;
            _missing = null;
        }

        StateHasChanged();
    }

    private static string HistoryText(IReadOnlyDictionary<string, string?> needed)
    {
        return string.Join(", ", needed.Select(pair => pair.Key + " from " + pair.Value));
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        _queue.StateChanged -= OnQueueChanged;
        _queue.Saved -= OnSaved;
    }
}
