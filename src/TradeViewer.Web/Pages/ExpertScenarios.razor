@page "/scenarios/expert"
@page "/scenarios/expert/{Id}"
@implements IDisposable
@inject ScenariosApi Api
@inject AssetsApi AssetsClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The scenario editor (SC1-SC16, SC20, SC21; decisions 0010 to 0012): the list, the chart of a scenario on its
   levels, previous and next, the asset and history it needs, and editing: a new scenario (SC9), the point tools of
   the level shown (SC10), the panel (SC12), saving in the background once the user changed something (SC13), the id
   at the first save (SC14), the problems at their fields (SC15), delete (SC16), undo and redo. Opening and stepping
   through the scenarios writes nothing. *@

<PageTitle>@(Id ?? "Expert scenarios") - TradeViewer</PageTitle>

<NavigationLock ConfirmExternalNavigation="@Unprotected" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<ScenarioChart @bind-ListOpen="_listOpen">
    <Toolbar>
        <strong class="chart-title">Expert scenarios</strong>
        @if (Writable)
        {
            <button type="button" title="A new expert scenario: asset, context timeframe and time span (SC9)" @onclick="OpenNewAsync">New</button>
        }
        <div class="segments" role="group" aria-label="Step through the list">
            <button type="button" title="The scenario before this one in the list" disabled="@(_list.Step(Id, -1) == null)" @onclick="() => Step(-1)">‹ Previous</button>
            <button type="button" title="The scenario after this one in the list" disabled="@(_list.Step(Id, +1) == null)" @onclick="() => Step(+1)">Next ›</button>
        </div>
        @if (_session != null)
        {
            <ScenarioLevelBar View="@_levels" OnChanged="LevelsChangedAsync" />
            <label title="Logarithmic price scale; the levels of a scenario are measured in log scale (SC3)">
                <input type="checkbox" checked="@_logScale" @onchange="e => _logScale = (bool)e.Value!" /> log
            </label>
            @if (Writable && _asset != null)
            {
                <ScenarioPointTools Tools="@Tools" Active="@_tool" Level="@_levels.Shown" CanUndo="@_session.CanUndo" CanRedo="@_session.CanRedo"
                                    OnChoose="ChooseToolAsync" OnUndo="UndoAsync" OnRedo="RedoAsync" />
            }
        }
        @if (_asset?.Loading == true)
        {
            <span class="badge loading">loading</span>
        }
    </Toolbar>

    <Chart>
        @if (_creating)
        {
            <NewScenarioDialog Choices="@_assets" Source="@_session?.Scenario.Source" Symbol="@_session?.Scenario.Symbol" Problem="@_createProblem"
                               OnCreate="CreateAsync" OnCancel="() => { _creating = false; _createProblem = null; }" />
        }
        @if (_status != null && !_status.Enabled)
        {
            <p class="chart-note">No scenario folder is configured (Scenarios:RootPath, see the runbook).</p>
        }
        else if (_openError != null)
        {
            <p class="status-bad chart-note">@_openError</p>
        }
        else if (_session == null)
        {
            <p class="chart-note muted">@(Id == null ? "Choose a scenario from the list, or make a new one." : "Loading...")</p>
        }
        else if (_asset == null)
        {
            <div class="chart-note scenario-notice">
                <p>@_session.Scenario.Source/@_session.Scenario.Symbol is not one of your assets, so its chart cannot be shown (SC6).</p>
                <button type="button" disabled="@_busy" @onclick="AddAssetAsync">Add @_session.Scenario.Symbol</button>
                @if (_actionProblem != null)
                {
                    <span class="status-bad">@_actionProblem</span>
                }
            </div>
        }
        else
        {
            @if (_session.Response.Asset.HistoryNeeded.Count > 0)
            {
                <div class="scenario-notice">
                    <span>The stored history of @_asset.Symbol starts after this scenario: @HistoryText(_session.Response.Asset.HistoryNeeded).</span>
                    <button type="button" disabled="@_busy" @onclick="LoadHistoryAsync">Load it</button>
                    @if (_actionProblem != null)
                    {
                        <span class="status-bad">@_actionProblem</span>
                    }
                </div>
            }
            @if (_editProblem != null)
            {
                <div class="scenario-notice">
                    <span class="status-bad">@_editProblem</span>
                    <button type="button" class="link-button" title="Dismiss" @onclick="() => _editProblem = null">✕</button>
                </div>
            }
            @if (Chartable)
            {
                <ChartHost @ref="_chart"
                           Source="@_asset.Source"
                           Symbol="@_asset.Symbol"
                           Timeframe="@(_levels.Timeframe ?? "")"
                           TickSize="@_asset.TickSize"
                           Timeframes="@ChartableTimeframes"
                           LogScale="@_logScale"
                           KeepTimesOnTimeframeChange="true"
                           OnReady="OnChartReadyAsync"
                           OnPointPlaced="OnPointPlacedAsync"
                           OnPointSelected="OnPointSelected"
                           OnScenarioToolChanged="OnScenarioToolChanged"
                           OnKey="OnKeyAsync" />
            }
            else
            {
                <p class="chart-note">@_asset.Symbol has no candles in @_levels.Timeframe yet.</p>
            }
        }
    </Chart>

    <List>
        <ExpertScenarioList View="@_list" Selected="@Id" ReadAt="@_readAt" Problem="@_listProblem"
                            OnSelect="Open" OnReload="ReadListAsync" OnChanged="StateHasChanged" />
    </List>

    <Panel>
        <ExpertScenarioPanel Response="@_session?.Response" ReadOnly="@(!Writable)" SelectedPoint="@_selectedPoint"
                             SaveText="@SaveText" SaveBad="@(_queue.Problem != null)"
                             OnChange="ChangeAsync" OnWave1Pattern="ChangeWave1PatternAsync" OnSelectPoint="SelectPointAsync" OnDelete="DeleteAsync" />
    </Panel>
</ScenarioChart>

@code {
    private static readonly TimeSpan ListInterval = TimeSpan.FromSeconds(30);

    private readonly ExpertScenarioListView _list = new ExpertScenarioListView();
    private readonly ScenarioLevelView _levels = new ScenarioLevelView();

    /// <summary>One change at a time: a snap, a field, undo or redo each start from the scenario the one before left.</summary>
    private readonly SemaphoreSlim _edits = new SemaphoreSlim(1, 1);

    private ExpertScenarioSaveQueue _queue = null!;
    private ScenariosStatusResponse? _status;
    private ExpertScenarioSession? _session;
    private AssetResponse? _asset;
    private IReadOnlyList<AssetResponse> _assets = Array.Empty<AssetResponse>();
    private ChartHost? _chart;
    private Timer? _timer;
    private DateTimeOffset? _readAt;
    private string? _listProblem;
    private string? _openError;
    private string? _actionProblem;
    private string? _editProblem;
    private string? _createProblem;
    private string? _opened;
    private string? _tool;
    private string? _selectedPoint;
    private bool _listOpen = true;
    private bool _logScale = true;
    private bool _busy;
    private bool _creating;
    private bool _showSpan;
    private bool _leaveConfirmed;
    private bool _disposed;

    [Parameter]
    public string? Id { get; set; }

    private bool Writable => _status?.Writable == true;

    private bool Chartable => _asset != null && _levels.Timeframe != null && _asset.Timeframes.Any(timeframe => timeframe.Timeframe == _levels.Timeframe && timeframe.Chartable);

    private IReadOnlyList<string> ChartableTimeframes => _asset?.Timeframes.Where(timeframe => timeframe.Chartable).Select(timeframe => timeframe.Timeframe).ToList() ?? new List<string>();

    private IReadOnlyList<ScenarioPointTool> Tools => _session == null ? Array.Empty<ScenarioPointTool>() : ScenarioPoints.ToolsOf(_levels.Shown, _session.Scenario);

    /// <summary>A new scenario the user changed that cannot be saved yet, because wave 2 end is missing (SC14).</summary>
    private bool WaitsForWave2End => _session != null && _session.Changed && _session.WaitsForWave2End && _queue.IdOf(_session.Key) == null;

    /// <summary>Leaving now would lose a change: one not confirmed yet, or a new scenario that cannot be saved yet.</summary>
    private bool Unprotected => _queue.HasUnsaved || WaitsForWave2End;

    private string? SaveText
    {
        get
        {
            if (_session == null)
            {
                return null;
            }

            if (!Writable)
            {
                return "read only: the scenario folder cannot be written";
            }

            if (_queue.Problem != null)
            {
                return _queue.Problem;
            }

            if (WaitsForWave2End)
            {
                return "not saved yet: it is saved once wave 2 end is placed (the id needs its month)";
            }

            if (_queue.IsUnsaved(_session.Key))
            {
                return "saving...";
            }

            return _session.Changed ? "saved" : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _queue = new ExpertScenarioSaveQueue(Api);
        _queue.StateChanged += OnQueueChanged;
        _queue.Saved += OnSaved;

        var status = await Api.GetStatusAsync();
        _status = status.Value;
        if (_status?.Enabled == true)
        {
            await ReadListAsync();
            _timer = new Timer(_ => _ = InvokeAsync(ReadListAsync), null, ListInterval, ListInterval);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _opened && _status?.Enabled == true)
        {
            _opened = Id;
            await OpenAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showSpan && _chart?.IsReady == true)
        {
            _showSpan = false;
            await ShowScenarioAsync(positionOnSpan: true);
        }
    }

    /// <summary>SC5: the folder is read on every call; the server reads only the files that changed.</summary>
    private async Task ReadListAsync()
    {
        if (_disposed)
        {
            return;
        }

        var list = await Api.ListAsync();
        _listProblem = list.Error;
        if (list.Value != null)
        {
            _list.Set(list.Value);
            _readAt = DateTimeOffset.UtcNow;
        }

        StateHasChanged();
    }

    private async Task OpenAsync()
    {
        _session = null;
        _openError = null;
        _actionProblem = null;
        _editProblem = null;
        _tool = null;
        _selectedPoint = null;
        if (Id == null)
        {
            return;
        }

        var response = await Api.GetAsync(Id);
        if (response.Value == null)
        {
            _openError = response.Error;
            return;
        }

        // A change of this scenario the server has not confirmed yet wins over the file (WS1, priority 1).
        var unsent = _queue.UnsentOf(Id);
        if (unsent != null)
        {
            var preview = await Api.PreviewAsync(unsent);
            response = preview.Value != null ? preview : response;
        }

        var key = _queue.KeyOf(Id);
        StartSession(key == null ? new ExpertScenarioSession(response.Value!) : new ExpertScenarioSession(key.Value, response.Value!));
        await ReadAssetAsync();
    }

    private void StartSession(ExpertScenarioSession session)
    {
        _session = session;
        _levels.Open(session.Response.Levels);
        _showSpan = true;
        if (_chart?.IsReady == true)
        {
            StateHasChanged(); // the chart may need another timeframe first; the span follows after the render
        }
    }

    private async Task ReadAssetAsync()
    {
        var assets = await AssetsClient.GetAssetsAsync();
        _assets = assets.Value ?? (IReadOnlyList<AssetResponse>)Array.Empty<AssetResponse>();
        _asset = _assets.FirstOrDefault(asset => asset.Source == _session?.Scenario.Source && asset.Symbol == _session?.Scenario.Symbol);
    }

    private async Task OnChartReadyAsync()
    {
        if (_session != null)
        {
            _showSpan = false;
            await ShowScenarioAsync(positionOnSpan: true);
        }
    }

    /// <summary>
    /// The shapes of the scenario with the groups hidden that the level shown does not show (SC21), the handles of the
    /// points of that level (SC10), and on opening the span (SC2).
    /// </summary>
    private async Task ShowScenarioAsync(bool positionOnSpan)
    {
        if (_chart == null || _session == null)
        {
            return;
        }

        var response = _session.Response;
        await _chart.SetOverlaysAsync(response.Groups, _levels.HiddenKeys(response.Groups));
        var handles = _levels.IsHidden(_levels.Shown) ? Array.Empty<ScenarioHandle>() : ScenarioPoints.HandlesOf(response.Scenario, _levels.Shown, Writable);
        await _chart.SetScenarioPointsAsync(handles);
        await _chart.SelectScenarioPointAsync(_selectedPoint);
        var scenario = response.Scenario;
        if (positionOnSpan && scenario.From != null)
        {
            await _chart.ShowTimeRangeAsync(scenario.From.Value, scenario.To ?? DateTimeOffset.UtcNow);
        }
    }

    private async Task LevelsChangedAsync()
    {
        // Another level offers other tools; the one in use goes back to the pointer.
        await ChooseToolAsync(null);
        _selectedPoint = null;
        StateHasChanged(); // another timeframe is a new series of the chart; the shapes stay, the groups follow the level
        await ShowScenarioAsync(positionOnSpan: false);
    }

    private async Task ChooseToolAsync(ScenarioPointTool? tool)
    {
        _tool = tool?.Tool.Code;
        if (_chart != null)
        {
            await _chart.SetScenarioToolAsync(tool?.Tool);
        }
    }

    private void OnScenarioToolChanged(string? code)
    {
        _tool = code;
    }

    private void OnPointSelected(string? key)
    {
        _selectedPoint = key;
    }

    private async Task SelectPointAsync(string key)
    {
        _selectedPoint = key;
        if (_chart != null)
        {
            await _chart.SelectScenarioPointAsync(key);
        }
    }

    /// <summary>A point placed with a tool or let go after a drag: the server snaps it on its timeframe (SC10).</summary>
    private Task OnPointPlacedAsync(PlacedPoint point)
    {
        var time = DateTimeOffset.FromUnixTimeSeconds(point.Time);
        return EditAsync(scenario => Api.SnapAsync(new SnapScenarioPointRequest(scenario, point.Field, time, point.Price, point.Index, point.Kind)));
    }

    /// <summary>A field of the panel (SC12).</summary>
    private Task ChangeAsync(ExpertScenarioRecord changed)
    {
        return EditAsync(_ => Api.PreviewAsync(changed));
    }

    /// <summary>Proposal 9: choosing the other pattern of wave 1 removes the points of the first after a confirmation; undo brings them back.</summary>
    private async Task ChangeWave1PatternAsync(string? pattern)
    {
        if (_session == null)
        {
            return;
        }

        var dropped = ScenarioPoints.Wave1PointsDroppedBy(_session.Scenario, pattern);
        if (dropped > 0 && !await JS.InvokeAsync<bool>("confirm", "A " + pattern + " has other points: " + dropped + " point(s) of wave 1 are removed. Go on?"))
        {
            StateHasChanged(); // the select shows the pattern of the scenario again
            return;
        }

        var setup = _session.Response.Levels.FirstOrDefault(level => level.Level == ScenarioPoints.Setup)?.Timeframe ?? "";
        await EditAsync(scenario => Api.PreviewAsync(ScenarioPoints.WithWave1Pattern(scenario, pattern, setup)));
    }

    private Task RemoveSelectedPointAsync()
    {
        var key = _selectedPoint;
        if (key == null)
        {
            return Task.CompletedTask;
        }

        _selectedPoint = null;
        return EditAsync(scenario => Api.PreviewAsync(ScenarioPoints.Remove(scenario, key)));
    }

    /// <summary>
    /// Runs one change of the scenario: the server answers with the scenario, its shapes and its problems, the chart
    /// shows them and the queue saves them. A change the server refuses (no candle there) leaves the scenario as it
    /// was and puts the handles back.
    /// </summary>
    private async Task EditAsync(Func<ExpertScenarioRecord, Task<ApiResult<ExpertScenarioResponse>>> change)
    {
        if (_session == null || !Writable)
        {
            return;
        }

        await _edits.WaitAsync();
        try
        {
            var session = _session;
            if (session == null)
            {
                return;
            }

            var answer = await change(session.Scenario);
            if (_session != session)
            {
                return; // another scenario was opened meanwhile
            }

            if (answer.Value == null)
            {
                _editProblem = answer.Error;
            }
            else
            {
                _editProblem = null;
                session.Change(answer.Value);
                Persist(session);
            }

            await ShowScenarioAsync(positionOnSpan: false);
        }
        finally
        {
            _edits.Release();
        }

        StateHasChanged();
    }

    private async Task UndoAsync()
    {
        await StepHistoryAsync(undo: true);
    }

    private async Task RedoAsync()
    {
        await StepHistoryAsync(undo: false);
    }

    private async Task StepHistoryAsync(bool undo)
    {
        if (_session == null || !Writable)
        {
            return;
        }

        await _edits.WaitAsync();
        try
        {
            var session = _session;
            var target = undo ? session?.UndoTarget() : session?.RedoTarget();
            if (session == null || target == null)
            {
                return;
            }

            var answer = await Api.PreviewAsync(target);
            if (_session != session)
            {
                return;
            }

            if (answer.Value == null)
            {
                _editProblem = answer.Error;
                return;
            }

            if (undo)
            {
                session.Undone(answer.Value);
            }
            else
            {
                session.Redone(answer.Value);
            }

            _selectedPoint = null;
            Persist(session);
            await ShowScenarioAsync(positionOnSpan: false);
        }
        finally
        {
            _edits.Release();
        }

        StateHasChanged();
    }

    /// <summary>SC13, SC14: saved once the user changed something; a new scenario only from the moment wave 2 end is placed.</summary>
    private void Persist(ExpertScenarioSession session)
    {
        if (session.Changed && (!session.WaitsForWave2End || _queue.IdOf(session.Key) != null))
        {
            _queue.Put(session.Key, session.Scenario);
        }
    }

    private void OnQueueChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>A save was confirmed: the first one gave the id, which becomes the address of the page (SC14).</summary>
    private void OnSaved(Guid key, ExpertScenarioRecord saved)
    {
        _ = InvokeAsync(async () =>
        {
            if (_session?.Key == key)
            {
                _session.Saved(saved);
                if (Id == null && saved.Id != null)
                {
                    _opened = saved.Id;
                    Navigation.NavigateTo("scenarios/expert/" + Uri.EscapeDataString(saved.Id), replace: true);
                }
            }

            await ReadListAsync();
        });
    }

    private async Task OnKeyAsync(string key)
    {
        switch (key)
        {
            case "delete":
                await RemoveSelectedPointAsync();
                break;
            case "undo":
                await UndoAsync();
                break;
            case "redo":
                await RedoAsync();
                break;
        }
    }

    private async Task OpenNewAsync()
    {
        var assets = await AssetsClient.GetAssetsAsync();
        _assets = assets.Value ?? (IReadOnlyList<AssetResponse>)Array.Empty<AssetResponse>();
        _createProblem = assets.Error;
        _creating = true;
    }

    /// <summary>SC9: the new scenario is shown at once; it is written only once wave 2 end is placed (SC14).</summary>
    private async Task CreateAsync(ExpertScenarioRecord scenario)
    {
        var answer = await Api.PreviewAsync(scenario);
        if (answer.Value == null)
        {
            _createProblem = answer.Error;
            return;
        }

        if (!await LeaveAllowedAsync())
        {
            return;
        }

        _creating = false;
        _createProblem = null;
        _opened = null;
        if (Id != null)
        {
            _leaveConfirmed = true;
            Navigation.NavigateTo("scenarios/expert");
        }

        _openError = null;
        _editProblem = null;
        _tool = null;
        _selectedPoint = null;
        StartSession(new ExpertScenarioSession(answer.Value));
        _asset = _assets.FirstOrDefault(asset => asset.Source == scenario.Source && asset.Symbol == scenario.Symbol);
    }

    /// <summary>SC16: after a confirmation; a new scenario that was never saved is only dropped.</summary>
    private async Task DeleteAsync()
    {
        var session = _session;
        if (session == null)
        {
            return;
        }

        var id = session.Scenario.Id ?? _queue.IdOf(session.Key);
        if (!await JS.InvokeAsync<bool>("confirm", id == null ? "Drop this new scenario?" : "Delete the expert scenario " + id + "? Its file is removed."))
        {
            return;
        }

        await _queue.ForgetAsync(session.Key);
        if (id != null)
        {
            var problem = await Api.DeleteAsync(id);
            if (problem != null)
            {
                _editProblem = problem;
                return;
            }
        }

        var next = id == null ? null : _list.Step(id, +1) ?? _list.Step(id, -1);
        _session = null;
        _opened = null;
        await ReadListAsync();
        if (next != null && next != id)
        {
            Open(next);
        }
        else if (Id != null)
        {
            Navigation.NavigateTo("scenarios/expert");
        }
    }

    /// <summary>SC14: a new scenario that is not saved yet is lost when another one is opened; the user is asked first.</summary>
    private async Task<bool> LeaveAllowedAsync()
    {
        if (WaitsForWave2End)
        {
            return await JS.InvokeAsync<bool>("confirm", "The new scenario is not saved: it is saved once wave 2 end is placed. Leave it?");
        }

        return true;
    }

    private async Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        var target = Navigation.ToBaseRelativePath(Navigation.ToAbsoluteUri(context.TargetLocation).ToString()); // the target may be relative
        var stays = target.StartsWith("scenarios/expert", StringComparison.Ordinal);
        if (_leaveConfirmed)
        {
            _leaveConfirmed = false; // asked already by the action that navigates
            return;
        }

        if (WaitsForWave2End && !await LeaveAllowedAsync())
        {
            context.PreventNavigation();
            return;
        }

        if (!stays && _queue.HasUnsaved && !await JS.InvokeAsync<bool>("confirm", "A change is not saved yet. Leave the page?"))
        {
            context.PreventNavigation();
        }
    }

    private void Open(string id)
    {
        Navigation.NavigateTo("scenarios/expert/" + Uri.EscapeDataString(id));
    }

    private void Step(int step)
    {
        var id = _list.Step(Id, step);
        if (id != null)
        {
            Open(id);
        }
    }

    /// <summary>SC6: the asset is added only when the user agrees.</summary>
    private async Task AddAssetAsync()
    {
        var scenario = _session!.Scenario;
        if (!await JS.InvokeAsync<bool>("confirm", "Add " + scenario.Symbol + " (" + scenario.Source + ") to your assets? Its history is then downloaded and imported."))
        {
            return;
        }

        await RunAsync(async () =>
        {
            var added = await AssetsClient.AddAsync(scenario.Source, scenario.Symbol);
            return added.Error;
        });
    }

    /// <summary>SC6: the history starts the span needs, as the server named them.</summary>
    private Task LoadHistoryAsync()
    {
        var session = _session!;
        return RunAsync(async () =>
        {
            var changed = await AssetsClient.ChangeHistoryAsync(session.Scenario.Source, session.Scenario.Symbol, session.Response.Asset.HistoryNeeded);
            return changed.Error;
        });
    }

    /// <summary>Runs an action on the asset, then waits until it has loaded and opens the scenario again.</summary>
    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _actionProblem = await action();
        if (_actionProblem == null)
        {
            for (var attempt = 0; attempt < 300 && !_disposed; attempt++)
            {
                await ReadAssetAsync();
                StateHasChanged();
                if (_asset != null && !_asset.Loading)
                {
                    break;
                }

                await Task.Delay(2000);
            }

            await ReopenAsync();
            if (_chart != null)
            {
                await _chart.ReloadSeriesAsync();
            }
        }

        _busy = false;
    }

    /// <summary>After the asset changed: the scenario as the user has it, with the asset state read again; its undo stays.</summary>
    private async Task ReopenAsync()
    {
        var session = _session;
        if (session == null)
        {
            return;
        }

        var answer = await Api.PreviewAsync(session.Scenario);
        if (answer.Value != null && _session == session)
        {
            session.Refresh(answer.Value);
            await ReadAssetAsync();
            _showSpan = true;
        }
    }

    private static string HistoryText(IReadOnlyDictionary<string, string?> needed)
    {
        return string.Join(", ", needed.Select(pair => pair.Key + " from " + pair.Value));
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        _queue.StateChanged -= OnQueueChanged;
        _queue.Saved -= OnSaved;
    }
}
