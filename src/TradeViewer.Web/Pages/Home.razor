@page "/"
@inject WorkspaceApi Workspace
@inject AssetsApi AssetList
@inject NavigationManager Navigation

<PageTitle>TradeViewer</PageTitle>

@* Opening TradeViewer without an address opens the chart last used (CP3); without one, the assets page. *@
@if (_error != null)
{
    <p class="status-bad">@_error</p>
}
else
{
    <p class="muted">Opening the last chart...</p>
}

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Workspace.GetSettingsAsync();
        var assets = await AssetList.GetAssetsAsync();
        if (settings.Value == null || assets.Value == null)
        {
            _error = settings.Error ?? assets.Error;
            return;
        }

        // The last chart only counts while its asset still exists with that timeframe.
        var last = settings.Value.LastChart;
        var asset = last == null ? null : assets.Value.FirstOrDefault(item => item.Source == last.Source && item.Symbol == last.Symbol);
        var address = last != null && asset != null && asset.Timeframes.Any(timeframe => timeframe.Timeframe == last.Timeframe)
            ? Chart.Address(last.Source, last.Symbol, last.Timeframe)
            : "assets";

        Navigation.NavigateTo(address, replace: true);
    }
}
