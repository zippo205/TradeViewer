@page "/chart/{Source}/{Symbol}/{Timeframe}"
@implements IDisposable
@inject AssetsApi Api

@inject WorkspaceApi Workspace
@inject WorkspaceEvents Events
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Symbol @Timeframe - TradeViewer</PageTitle>

<div class="chart-page">
    <div class="chart-toolbar">
        @if (_asset != null)
        {
            <strong class="chart-title">@_asset.DisplayName <small>@_asset.Source</small></strong>
        }

        @if (_asset != null)
        {
            <div class="segments" role="group" aria-label="Timeframe">
                @foreach (var timeframe in _asset.Timeframes)
                {
                    <button type="button"
                            class="@(timeframe.Timeframe == Timeframe ? "selected" : "")"
                            disabled="@(!timeframe.Chartable)"
                            title="@(timeframe.Chartable ? null : "No candles yet")"
                            @onclick="() => Open(Source, Symbol, timeframe.Timeframe)">
                        @timeframe.Timeframe
                    </button>
                }
            </div>

            <label title="Logarithmic price scale"><input type="checkbox" checked="@_logScale" @onchange="OnLogScaleChanged" /> log</label>

            @if (_asset.Loading)
            {
                <span class="badge loading">loading</span>
            }
        }

        <button type="button" class="panel-toggle" title="@(_panelOpen ? "Fold the watchlists away" : "Show the watchlists")" @onclick="TogglePanelAsync">
            @(_panelOpen ? "Watchlists »" : "« Watchlists")
        </button>
    </div>

    <div class="chart-body">
    <div class="chart-area">
    @if (_error != null)
    {
        <p class="status-bad chart-note">@_error</p>
    }
    else if (_assets != null && _asset == null)
    {
        <p class="chart-note">
            @Source/@Symbol is not one of your assets. <a href="assets">Add it on the assets page</a>.
        </p>
    }
    else if (_asset != null && _shown != null)
    {
        @* The chart stays while another asset's settings are read: it keeps its view and switches in one step (CH3). *@
        <ChartHost @ref="_chart"
                   Source="@_shown.Source"
                   Symbol="@_shown.Symbol"
                   Timeframe="@_shown.Timeframe"
                   TickSize="@_shown.TickSize"
                   LogScale="@_logScale" />
    }
    </div>
    @if (_panelOpen)
    {
        <WatchlistPanel Source="@Source" Symbol="@Symbol" OnSelected="OnRowSelected" />
    }
    </div>
</div>

@code {
    private List<AssetResponse>? _assets;
    private AssetResponse? _asset;
    private ChartHost? _chart;
    private string? _error;
    private const string PanelKey = "tradeviewer.watchlist.panel";

    private bool _panelOpen = true;
    private bool _logScale;
    private bool _settingsRead;
    private ShownSeries? _shown;
    private string? _rememberedChart;
    private bool _disposed;

    [Parameter]
    public string Source { get; set; } = string.Empty;

    [Parameter]
    public string Symbol { get; set; } = string.Empty;

    [Parameter]
    public string Timeframe { get; set; } = string.Empty;

    /// <summary>The address of a chart: asset and timeframe are part of it (CP1).</summary>
    public static string Address(string source, string symbol, string timeframe)
    {
        return "chart/" + Uri.EscapeDataString(source) + "/" + Uri.EscapeDataString(symbol) + "/" + Uri.EscapeDataString(timeframe);
    }

    protected override async Task OnInitializedAsync()
    {
        Events.CandlesUpdated += OnCandlesUpdated;
        Events.AssetStatusChanged += OnAssetStatusChanged;
        Events.Reconnected += OnReconnected;
        _ = Events.StartAsync();

        // The price scale mode is one setting for all charts (CP2): read once, before the first chart is drawn.
        var settings = await Workspace.GetSettingsAsync();
        _logScale = settings.Value?.PriceScale == PriceScales.Log;

        await LoadAssetsAsync();
        _settingsRead = true;
        OpenChart();
    }

    protected override Task OnParametersSetAsync()
    {
        // The address changed (selector, back and forward, a link): the same page shows another chart.
        _asset = _assets?.FirstOrDefault(asset => asset.Source == Source && asset.Symbol == Symbol);
        OpenChart();
        return Task.CompletedTask;
    }

    /// <summary>Shows the chart of the address and remembers it as the last one (CP3).</summary>
    private void OpenChart()
    {
        if (_asset == null || !_settingsRead)
        {
            return;
        }

        _shown = new ShownSeries(Source, Symbol, Timeframe, _asset.TickSize);

        var chart = Key(Source, Symbol) + "/" + Timeframe;
        if (_rememberedChart != chart && _asset.Timeframes.Any(timeframe => timeframe.Timeframe == Timeframe))
        {
            _rememberedChart = chart;
            _ = Workspace.SaveLastChartAsync(Source, Symbol, Timeframe);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Events.CandlesUpdated -= OnCandlesUpdated;
        Events.AssetStatusChanged -= OnAssetStatusChanged;
        Events.Reconnected -= OnReconnected;
    }

    private async Task LoadAssetsAsync()
    {
        var result = await Api.GetAssetsAsync();
        if (result.Value == null)
        {
            _error = result.Error;
            return;
        }

        _error = null;
        _assets = result.Value;
        _asset = _assets.FirstOrDefault(asset => asset.Source == Source && asset.Symbol == Symbol);
    }

    /// <summary>Selecting an asset in a watchlist shows it in this window (CP1).</summary>
    private async Task OnRowSelected(WatchlistRowResponse row)
    {
        if (row.Timeframes.Count == 0)
        {
            return;
        }

        // An asset added in another window is not known here yet.
        if (_assets == null || !_assets.Any(asset => asset.Source == row.Source && asset.Symbol == row.Symbol))
        {
            await LoadAssetsAsync();
        }

        // The timeframe stays when the other asset has it with candles, otherwise its largest one with candles.
        var timeframe = row.Timeframes.Contains(Timeframe) ? Timeframe : row.Timeframes[row.Timeframes.Count - 1];
        Open(row.Source, row.Symbol, timeframe);
    }

    private async Task TogglePanelAsync()
    {
        _panelOpen = !_panelOpen;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", PanelKey, _panelOpen ? "open" : "folded");
        }
        catch (JSException)
        {
            // no storage in this browser: the choice lasts as long as the window
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", PanelKey) == "folded")
            {
                _panelOpen = false;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // the panel stays open
        }
    }

    /// <summary>The price scale mode shows at once and is saved in the background; it stays for every asset and timeframe (CP2).</summary>
    private void OnLogScaleChanged(ChangeEventArgs e)
    {
        _logScale = e.Value is true;
        _ = Workspace.SavePriceScaleAsync(_logScale ? PriceScales.Log : PriceScales.Linear);
    }

    private void Open(string source, string symbol, string timeframe)
    {
        Navigation.NavigateTo(Address(source, symbol, timeframe));
    }

    /// <summary>New candles of the shown asset: the chart reads them without a reload (MD2).</summary>
    private void OnCandlesUpdated(string source, string symbol, string[] timeframes)
    {
        if (source != Source || symbol != Symbol || _disposed)
        {
            return;
        }

        // The current candle of a larger timeframe is built from the smallest one, so any timeframe counts (MD8).
        _ = InvokeAsync(async () =>
        {
            if (_chart != null)
            {
                await _chart.RefreshAsync();
            }
        });
    }

    private void OnAssetStatusChanged(string source, string symbol)
    {
        if (source == Source && symbol == Symbol && !_disposed)
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAssetsAsync();
                StateHasChanged();
            });
        }
    }

    /// <summary>After a break of the connection events may have been missed: read everything shown again.</summary>
    private void OnReconnected()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAssetsAsync();
            if (_chart != null)
            {
                await _chart.RefreshAsync();
            }

            StateHasChanged();
        });
    }

    private static string Key(string source, string symbol)
    {
        return source + "/" + symbol;
    }

    /// <summary>What the chart shows right now; it follows the address once the settings of the asset are read.</summary>
    private sealed record ShownSeries(string Source, string Symbol, string Timeframe, double TickSize);
}
