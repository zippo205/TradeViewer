@page "/chart/{Source}/{Symbol}/{Timeframe}"
@implements IDisposable
@inject AssetsApi Api
@inject DrawingsApi DrawingsApi
@inject IndicatorsApi IndicatorsApi
@inject DrawingSession Session
@inject DrawingSaveQueue Saves

@inject WorkspaceApi Workspace
@inject ScenariosApi Scenarios
@inject WorkspaceEvents Events
@inject WindowIdentity Window
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Symbol @Timeframe - TradeViewer</PageTitle>

<div class="chart-page">
    <div class="chart-toolbar">
        @if (_asset != null)
        {
            <strong class="chart-title">@_asset.DisplayName <small>@_asset.Source</small></strong>
        }

        @if (_asset != null)
        {
            <div class="segments" role="group" aria-label="Timeframe">
                @foreach (var timeframe in _asset.Timeframes)
                {
                    <button type="button"
                            class="@(timeframe.Timeframe == Timeframe ? "selected" : "")"
                            disabled="@(!timeframe.Chartable)"
                            title="@(timeframe.Chartable ? null : "No candles yet")"
                            @onclick="() => Open(Source, Symbol, timeframe.Timeframe)">
                        @timeframe.Timeframe
                    </button>
                }
            </div>

            <label title="Logarithmic price scale"><input type="checkbox" checked="@_logScale" @onchange="OnLogScaleChanged" /> log</label>

            <IndicatorMenu Enabled="@IndicatorsEditable" OnAdd="AddIndicatorAsync" />
            <TemplateMenu Enabled="@IndicatorsEditable" Current="@_indicators" OnApply="ApplyTemplateAsync" />
            @if (_indicatorError != null)
            {
                <span class="status-bad">@_indicatorError</span>
            }

            @if (_asset.Loading)
            {
                <span class="badge loading">loading</span>
            }
        }

        <button type="button" class="panel-toggle" title="@(_panelOpen ? "Fold the watchlists away" : "Show the watchlists")" @onclick="TogglePanelAsync">
            @(_panelOpen ? "Watchlists »" : "« Watchlists")
        </button>
    </div>

    <div class="chart-body">
    <div class="chart-area">
    @if (_error != null)
    {
        <p class="status-bad chart-note">@_error</p>
    }
    else if (_assets != null && _asset == null)
    {
        <p class="chart-note">
            @Source/@Symbol is not one of your assets. <a href="assets">Add it on the assets page</a>.
        </p>
    }
    else if (_asset != null && _shown != null)
    {
        <div class="chart-with-tools">
            <DrawingToolbar Tool="@_tool" Magnet="@_magnet" Hidden="@_hidden"
                            CanUndo="@Session.CanUndo" CanRedo="@Session.CanRedo" Problem="@(_drawingError ?? Saves.Problem)"
                            Pattern="@_pattern" LastPattern="@_lastPattern" OnPattern="ChoosePatternAsync"
                            RangeShown="@_scenariosWritable" RangeEnabled="@RangeEnabled" RangeActive="@_rangeTool" OnRange="ChooseRangeToolAsync"
                            OnTool="ChooseToolAsync" OnMagnet="SetMagnetAsync" OnHidden="SetHiddenAsync"
                            OnUndo="() => Session.Undo()" OnRedo="() => Session.Redo()" />
            <div class="chart-canvas-area">
                @* The chart stays while another asset's settings are read: it keeps its view and switches in one step (CH3). *@
                <ChartHost @ref="_chart"
                           Source="@_shown.Source"
                           Symbol="@_shown.Symbol"
                           Timeframe="@_shown.Timeframe"
                           TickSize="@_shown.TickSize"
                           Timeframes="@_shown.Timeframes"
                           LogScale="@_logScale"
                           OnReady="OnChartReadyAsync"
                           OnDrawingCreated="OnDrawingCreated"
                           OnDrawingChanged="OnDrawingChanged"
                           OnSelectionChanged="OnSelectionChanged"
                           OnToolChanged="OnToolChanged"
                           OnIndicatorAction="OnIndicatorActionAsync"
                           OnRangeSelected="OnRangeSelected"
                           OnRangeToolChanged="on => _rangeTool = on"
                           OnKey="OnKey" />
                @if (_editing != null)
                {
                    <IndicatorSettingsDialog Indicator="@_editing" Defaults="@DefaultOf(_editing.Type)" Problem="@_editingProblem"
                                             OnSave="SaveEditedIndicatorAsync" OnCancel="() => { _editing = null; _editingProblem = null; }" />
                }
                @if (Session.Selected != null && !_hidden)
                {
                    <DrawingBar Drawing="@Session.Selected" Wave="@((_waveDegree, _waveLabel))" OnEdit="OnDrawingEdited" OnDelete="() => Session.Delete(Session.Selected.Id)" />
                }
                @if ((_tool == "waveLabel" || _pattern != null) && !_hidden)
                {
                    <WaveChooser Degree="@_waveDegree" Label="@_waveLabel" Pattern="@WavePatterns.Find(_pattern)" OnChanged="OnWaveChosen" />
                }
                @if (KindOf(_tool) is string kind && !_hidden)
                {
                    <FibonacciChooser Presets="@PresetsOf(kind)" Selected="@(PresetOf(kind)?.Id ?? Guid.Empty)" OnChanged="id => OnPresetChosen(kind, id)" />
                }
            </div>
        </div>
    }
    </div>
    @if (_panelOpen)
    {
        <WatchlistPanel Source="@Source" Symbol="@Symbol" OnSelected="OnRowSelected" />
    }
    </div>
</div>

@code {
    private List<AssetResponse>? _assets;
    private AssetResponse? _asset;
    private ChartHost? _chart;
    private string? _error;
    private const string PanelKey = "tradeviewer.watchlist.panel";

    private bool _panelOpen = true;
    private bool _logScale;
    private bool _settingsRead;
    private ShownSeries? _shown;
    private string? _rememberedChart;
    private bool _disposed;

    // Drawings (DR1-DR6): the tool in use, magnet and "all hidden", the asset whose drawings are shown.
    private string? _tool;
    private bool _magnet = true;
    private bool _scenariosWritable;
    private bool _rangeTool;
    private bool _hidden;
    private string? _drawingsAsset;
    private string? _drawingError;
    private string _waveDegree = WaveLabels.FirstDegree;
    private string _waveLabel = "1";
    private string? _pattern;
    private string? _lastPattern;
    private List<FibonacciPresetRecord> _presets = new List<FibonacciPresetRecord>();

    // Indicators (IN1, IN2): those of the asset shown, as its chart settings hold them, and the asset they belong to.
    private List<IndicatorRecord> _indicators = new List<IndicatorRecord>();
    private string? _settingsAsset;
    private List<IndicatorRecord> _indicatorDefaults = new List<IndicatorRecord>();
    private IndicatorRecord? _editing;
    private string? _editingProblem;
    private string? _indicatorError;
    private readonly SemaphoreSlim _settingsSaves = new SemaphoreSlim(1, 1);

    /// <summary>The preset chosen per kind (retracement, extension) in this window; the first of the kind before a choice.</summary>
    private readonly Dictionary<string, Guid> _chosenPresets = new Dictionary<string, Guid>();

    [Parameter]
    public string Source { get; set; } = string.Empty;

    [Parameter]
    public string Symbol { get; set; } = string.Empty;

    [Parameter]
    public string Timeframe { get; set; } = string.Empty;

    /// <summary>The address of a chart: asset and timeframe are part of it (CP1).</summary>
    public static string Address(string source, string symbol, string timeframe)
    {
        return "chart/" + Uri.EscapeDataString(source) + "/" + Uri.EscapeDataString(symbol) + "/" + Uri.EscapeDataString(timeframe);
    }

    protected override async Task OnInitializedAsync()
    {
        Events.CandlesUpdated += OnCandlesUpdated;
        Events.DrawingsChanged += OnDrawingsChanged;
        Events.ChartSettingsChanged += OnChartSettingsChanged;
        Events.AssetStatusChanged += OnAssetStatusChanged;
        Events.Reconnected += OnReconnected;
        _ = Events.StartAsync();
        Session.Changed += OnSessionChanged;
        Saves.StateChanged += OnSavesChanged;

        // The price scale mode is one setting for all charts (CP2): read once, before the first chart is drawn.
        var settings = await Workspace.GetSettingsAsync();
        _logScale = settings.Value?.PriceScale == PriceScales.Log;
        _magnet = settings.Value?.Magnet ?? true;

        // The Fibonacci presets (DR4): a new Fibonacci drawing copies the levels of the one chosen.
        var presets = await DrawingsApi.GetPresetsAsync();
        _presets = presets.Value ?? new List<FibonacciPresetRecord>();

        // A new indicator starts with TradingView's defaults (IN1); they live in the Domain and are read here once.
        var defaults = await IndicatorsApi.GetDefaultsAsync();
        _indicatorDefaults = defaults.Value ?? new List<IndicatorRecord>();

        // SC22: the range tool is offered only with a scenario folder that can be written.
        var scenarios = await Scenarios.GetStatusAsync();
        _scenariosWritable = scenarios.Value is { Enabled: true, Writable: true };

        await LoadAssetsAsync();
        _settingsRead = true;
        OpenChart();
    }

    protected override Task OnParametersSetAsync()
    {
        // The address changed (selector, back and forward, a link): the same page shows another chart.
        _asset = _assets?.FirstOrDefault(asset => asset.Source == Source && asset.Symbol == Symbol);
        OpenChart();
        if (_rangeTool && !RangeEnabled && _chart != null)
        {
            return _chart.SetRangeToolAsync(false); // a timeframe that is no context puts the range tool away (SC22)
        }

        return Task.CompletedTask;
    }

    /// <summary>Shows the chart of the address and remembers it as the last one (CP3).</summary>
    private void OpenChart()
    {
        if (_asset == null || !_settingsRead)
        {
            return;
        }

        _shown = new ShownSeries(Source, Symbol, Timeframe, _asset.TickSize, _asset.Timeframes.Where(timeframe => timeframe.Chartable).Select(timeframe => timeframe.Timeframe).ToList());
        ShowDrawingsOf(Source, Symbol);

        var chart = Key(Source, Symbol) + "/" + Timeframe;
        if (_rememberedChart != chart && _asset.Timeframes.Any(timeframe => timeframe.Timeframe == Timeframe))
        {
            _rememberedChart = chart;
            _ = Workspace.SaveLastChartAsync(Source, Symbol, Timeframe);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Events.CandlesUpdated -= OnCandlesUpdated;
        Events.DrawingsChanged -= OnDrawingsChanged;
        Events.ChartSettingsChanged -= OnChartSettingsChanged;
        Events.AssetStatusChanged -= OnAssetStatusChanged;
        Events.Reconnected -= OnReconnected;
        Session.Changed -= OnSessionChanged;
        Saves.StateChanged -= OnSavesChanged;
    }

    private async Task LoadAssetsAsync()
    {
        var result = await Api.GetAssetsAsync();
        if (result.Value == null)
        {
            _error = result.Error;
            return;
        }

        _error = null;
        _assets = result.Value;
        _asset = _assets.FirstOrDefault(asset => asset.Source == Source && asset.Symbol == Symbol);
    }

    /// <summary>Selecting an asset in a watchlist shows it in this window (CP1).</summary>
    private async Task OnRowSelected(WatchlistRowResponse row)
    {
        if (row.Timeframes.Count == 0)
        {
            return;
        }

        // An asset added in another window is not known here yet.
        if (_assets == null || !_assets.Any(asset => asset.Source == row.Source && asset.Symbol == row.Symbol))
        {
            await LoadAssetsAsync();
        }

        // The timeframe stays when the other asset has it with candles, otherwise the next larger one (decision 0008).
        var timeframe = TimeframeChoice.For(Timeframe, row.Timeframes);
        if (timeframe != null)
        {
            Open(row.Source, row.Symbol, timeframe);
        }
    }

    private async Task TogglePanelAsync()
    {
        _panelOpen = !_panelOpen;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", PanelKey, _panelOpen ? "open" : "folded");
        }
        catch (JSException)
        {
            // no storage in this browser: the choice lasts as long as the window
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", PanelKey) == "folded")
            {
                _panelOpen = false;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // the panel stays open
        }
    }

    /// <summary>The price scale mode shows at once and is saved in the background; it stays for every asset and timeframe (CP2).</summary>
    private void OnLogScaleChanged(ChangeEventArgs e)
    {
        _logScale = e.Value is true;
        _ = Workspace.SavePriceScaleAsync(_logScale ? PriceScales.Log : PriceScales.Linear);
    }

    private void Open(string source, string symbol, string timeframe)
    {
        Navigation.NavigateTo(Address(source, symbol, timeframe));
    }

    /// <summary>New candles of the shown asset: the chart reads them without a reload (MD2).</summary>
    private void OnCandlesUpdated(string source, string symbol, string[] timeframes)
    {
        if (source != Source || symbol != Symbol || _disposed)
        {
            return;
        }

        // The current candle of a larger timeframe is built from the smallest one, so any timeframe counts (MD8).
        _ = InvokeAsync(async () =>
        {
            if (_chart != null)
            {
                await _chart.RefreshAsync();
            }
        });
    }

    /// <summary>
    /// Another window saved or deleted a drawing of the asset shown: this one reads the drawings again, so a line
    /// drawn on 4h appears in the 1d window beside it (CP1). Its own changes it knows already.
    /// </summary>
    private void OnDrawingsChanged(string source, string symbol, string window)
    {
        if (source != Source || symbol != Symbol || window == Window.Id || _disposed)
        {
            return;
        }

        _ = InvokeAsync(() => LoadDrawingsAsync(source, symbol));
    }

    /// <summary>
    /// Another window saved the chart settings of the asset shown (its indicators, "drawings hidden"): this one reads
    /// them again, so its next save does not undo the other window's change (CP2, priority 1).
    /// </summary>
    private void OnChartSettingsChanged(string source, string symbol, string window)
    {
        if (source != Source || symbol != Symbol || window == Window.Id || _disposed)
        {
            return;
        }

        _ = InvokeAsync(() => LoadChartSettingsAsync(source, symbol));
    }

    private void OnAssetStatusChanged(string source, string symbol)
    {
        if (source == Source && symbol == Symbol && !_disposed)
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAssetsAsync();
                StateHasChanged();
            });
        }
    }

    /// <summary>After a break of the connection events may have been missed: read everything shown again.</summary>
    private void OnReconnected()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAssetsAsync();
            if (_chart != null)
            {
                await _chart.RefreshAsync();
            }

            await LoadDrawingsAsync(Source, Symbol);

            StateHasChanged();
        });
    }

    /// <summary>
    /// Another asset: its drawings replace those of the last one at once (none until they are read), and its
    /// "all hidden" comes with them (CP2). The timeframe alone changes nothing: drawings belong to the asset (DR3).
    /// </summary>
    private void ShowDrawingsOf(string source, string symbol)
    {
        var asset = Key(source, symbol);
        if (_drawingsAsset == asset)
        {
            return;
        }

        _drawingsAsset = asset;
        Session.Show(source, symbol, Array.Empty<DrawingRecord>());

        // The indicators of the last asset go at once, before the chart reads the candles of the new one.
        _indicators = new List<IndicatorRecord>();
        _settingsAsset = null;
        _editing = null;
        _ = PushIndicatorsAsync();
        _ = LoadDrawingsAsync(source, symbol);
    }

    private async Task LoadDrawingsAsync(string source, string symbol)
    {
        var drawings = await DrawingsApi.GetAsync(source, symbol);
        if (_disposed || _drawingsAsset != Key(source, symbol))
        {
            return; // the user has moved on to another asset meanwhile
        }

        _drawingError = drawings.Error == null ? null : "Drawings could not be read: " + drawings.Error;
        if (drawings.Value != null)
        {
            Session.Show(source, symbol, drawings.Value);
        }

        await LoadChartSettingsAsync(source, symbol);
    }

    /// <summary>The chart settings of the asset (CP2): "drawings hidden" and the indicators.</summary>
    private async Task LoadChartSettingsAsync(string source, string symbol)
    {
        var settings = await DrawingsApi.GetChartSettingsAsync(source, symbol);
        if (_disposed || _drawingsAsset != Key(source, symbol))
        {
            return;
        }

        if (settings.Value == null)
        {
            // Not read: the indicators stay as they are and cannot be changed, so no save replaces what is stored.
            _indicatorError = "Indicators could not be read: " + settings.Error;
            StateHasChanged();
            return;
        }

        _hidden = settings.Value.DrawingsHidden;
        _indicators = (settings.Value.Indicators ?? Array.Empty<IndicatorRecord>()).ToList();
        _settingsAsset = Key(source, symbol);
        _indicatorError = null;
        if (_editing != null && _indicators.All(indicator => indicator.Id != _editing.Id))
        {
            _editing = null; // removed in another window
        }

        await PushOptionsAsync();
        await PushIndicatorsAsync();
        StateHasChanged();
    }

    /// <summary>The chart is ready: it gets the drawings, the options and the tool shown so far.</summary>
    private async Task OnChartReadyAsync()
    {
        await PushOptionsAsync();
        await PushIndicatorsAsync();
        await PushDrawingsAsync();
        if (_chart != null)
        {
            await _chart.WarnWhenLeavingAsync(Saves.HasUnsaved);
        }
    }

    private async Task PushDrawingsAsync()
    {
        if (_chart != null)
        {
            var drawings = Session.Drawings.Select(ChartDrawings.ToChart).ToList();
            await _chart.SetDrawingsAsync(drawings, Session.SelectedId?.ToString());
        }
    }

    private async Task PushIndicatorsAsync()
    {
        if (_chart != null)
        {
            await _chart.SetIndicatorsAsync(_indicators);
        }
    }

    /// <summary>Indicators can be changed once the settings of the asset are read: a save replaces them as a whole.</summary>
    private bool IndicatorsEditable => _settingsAsset == Key(Source, Symbol) && _indicatorDefaults.Count > 0;

    private IndicatorRecord? DefaultOf(string type)
    {
        return _indicatorDefaults.FirstOrDefault(indicator => indicator.Type == type);
    }

    /// <summary>A new indicator with TradingView's defaults, below the others (IN1); it shows and is saved at once.</summary>
    private async Task AddIndicatorAsync(string type)
    {
        var template = DefaultOf(type);
        if (template == null || !IndicatorsEditable)
        {
            return;
        }

        _indicators = _indicators.Append(template with { Id = Guid.NewGuid() }).ToList();
        await PushIndicatorsAsync();
        await SaveChartSettingsAsync();
    }

    /// <summary>Applying a template replaces the indicators of the chart with copies of its own (proposal 4).</summary>
    private async Task ApplyTemplateAsync(IndicatorTemplateRecord template)
    {
        if (!IndicatorsEditable)
        {
            return;
        }

        _indicators = template.Indicators.Select(indicator => indicator with { Id = Guid.NewGuid() }).ToList();
        _editing = null;
        await PushIndicatorsAsync();
        await SaveChartSettingsAsync();
    }

    /// <summary>Hide, settings and remove from the legend line of an indicator.</summary>
    private async Task OnIndicatorActionAsync((string Id, string Action) request)
    {
        var indicator = _indicators.FirstOrDefault(candidate => candidate.Id.ToString() == request.Id);
        if (indicator == null || !IndicatorsEditable)
        {
            return;
        }

        switch (request.Action)
        {
            case "hide":
                _indicators = _indicators.Select(candidate => candidate.Id == indicator.Id ? candidate with { Hidden = !candidate.Hidden } : candidate).ToList();
                break;
            case "remove":
                _indicators = _indicators.Where(candidate => candidate.Id != indicator.Id).ToList();
                if (_editing?.Id == indicator.Id)
                {
                    _editing = null;
                }

                break;
            case "settings":
                _editing = indicator;
                _editingProblem = null;
                return;
            default:
                return;
        }

        await PushIndicatorsAsync();
        await SaveChartSettingsAsync();
    }

    /// <summary>OK in the settings dialog: shown and saved; a change the Api refuses keeps the dialog open with the reason.</summary>
    private async Task SaveEditedIndicatorAsync(IndicatorRecord edited)
    {
        var before = _indicators;
        _indicators = _indicators.Select(candidate => candidate.Id == edited.Id ? edited : candidate).ToList();
        var problem = await SaveChartSettingsAsync();
        if (problem != null)
        {
            _indicators = before;
            _editingProblem = problem;
            _indicatorError = null;
            return;
        }

        _editing = null;
        _editingProblem = null;
        await PushIndicatorsAsync();
    }

    /// <summary>
    /// Saves the chart settings of the asset at once (WS1), one save at a time, each with what the window shows when it
    /// is sent. Until the settings are read the indicators are left out, which keeps the saved ones (priority 1).
    /// </summary>
    /// <returns>Null when saved, otherwise the reason.</returns>
    private async Task<string?> SaveChartSettingsAsync()
    {
        await _settingsSaves.WaitAsync();
        try
        {
            var indicators = _settingsAsset == Key(Source, Symbol) ? _indicators : null;
            var problem = await DrawingsApi.SaveChartSettingsAsync(Source, Symbol, new ChartSettingsResponse(_hidden, indicators));
            _indicatorError = problem == null ? null : "Not saved: " + problem;
            return problem;
        }
        finally
        {
            _settingsSaves.Release();
        }
    }

    private async Task PushOptionsAsync()
    {
        if (_chart != null)
        {
            await _chart.SetDrawingOptionsAsync(_magnet, _hidden);
        }
    }

    /// <summary>The list or the selection changed (the user, undo, redo, reading again): the chart shows it.</summary>
    private void OnSessionChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(async () =>
            {
                await PushDrawingsAsync();
                StateHasChanged();
            });
        }
    }

    private void OnSavesChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(async () =>
            {
                if (_chart != null)
                {
                    await _chart.WarnWhenLeavingAsync(Saves.HasUnsaved);
                }

                StateHasChanged();
            });
        }
    }

    private async Task OnDrawingCreated(ChartDrawing drawing)
    {
        var record = ChartDrawings.ToRecord(drawing, Source, Symbol);
        if (record == null)
        {
            return;
        }

        Session.Created(record);

        // A wave label placed: the chooser moves on to the next label, and the tool, still in use, places that one.
        if (record.Tool == "waveLabel" && record.Wave != null)
        {
            _waveDegree = record.Wave.Degree;
            _waveLabel = WaveLabels.Next(record.Wave.Label);
            if (_tool == "waveLabel" && _chart != null)
            {
                await _chart.SetToolAsync("waveLabel", WaveExtras());
            }
        }
    }

    /// <summary>The chooser changed: the wave label tool, when in use, places the label chosen.</summary>
    private async Task OnWaveChosen((string Degree, string Label) wave)
    {
        _waveDegree = wave.Degree;
        _waveLabel = wave.Label;
        if ((_tool == "waveLabel" || _pattern != null) && _chart != null)
        {
            await _chart.SetToolAsync(_tool, ToolExtras(_tool));
        }
    }

    /// <summary>A wave pattern chosen in the group of the rail: a polyline whose points get the labels of the pattern.</summary>
    private async Task ChoosePatternAsync(string code)
    {
        _pattern = code;
        _lastPattern = code;
        if (_chart != null)
        {
            await _chart.SetToolAsync("polyline", ToolExtras("polyline")); // the chart answers with ToolChanged
        }
    }

    /// <summary>What a new drawing of the tool gets besides its anchors: a wave mark, or Fibonacci levels.</summary>
    private object? ToolExtras(string? tool)
    {
        if (tool == "waveLabel")
        {
            return WaveExtras();
        }

        var pattern = tool == "polyline" ? WavePatterns.Find(_pattern) : null;
        if (pattern != null)
        {
            return new { pattern = pattern.Labels, degree = _waveDegree };
        }

        var kind = KindOf(tool);
        var preset = kind == null ? null : PresetOf(kind);
        return preset == null ? null : new { levels = preset.Levels };
    }

    /// <summary>The kind of preset a Fibonacci tool uses; null for the other tools.</summary>
    private static string? KindOf(string? tool)
    {
        switch (tool)
        {
            case "fibonacciRetracement":
                return "retracement";
            case "fibonacciExtension":
                return "extension";
            default:
                return null;
        }
    }

    private IReadOnlyList<FibonacciPresetRecord> PresetsOf(string kind)
    {
        return _presets.Where(preset => preset.Kind == kind).ToList();
    }

    private FibonacciPresetRecord? PresetOf(string kind)
    {
        var presets = PresetsOf(kind);
        return _chosenPresets.TryGetValue(kind, out var id) && presets.Any(preset => preset.Id == id)
            ? presets.First(preset => preset.Id == id)
            : presets.FirstOrDefault();
    }

    /// <summary>Another preset chosen: the tool in use places its levels from now on.</summary>
    private async Task OnPresetChosen(string kind, Guid id)
    {
        _chosenPresets[kind] = id;
        if (KindOf(_tool) == kind && _chart != null)
        {
            await _chart.SetToolAsync(_tool, ToolExtras(_tool));
        }
    }

    /// <summary>What a new wave label gets: the degree and label of the chooser; the chart adds the side.</summary>
    private object WaveExtras()
    {
        return new { wave = new { degree = _waveDegree, label = _waveLabel } };
    }

    private void OnDrawingChanged(ChartDrawing drawing)
    {
        var record = ChartDrawings.ToRecord(drawing, Source, Symbol);
        if (record != null)
        {
            Session.Moved(record);
        }
    }

    private void OnSelectionChanged(string? id)
    {
        Session.Select(Guid.TryParse(id, out var selected) ? selected : null);
    }

    private void OnToolChanged(string? tool)
    {
        _tool = tool;
        if (tool != "polyline")
        {
            _pattern = null; // the pattern ended, or another tool was chosen
        }
    }

    private void OnDrawingEdited(DrawingRecord drawing)
    {
        Session.Edit(drawing);
    }

    /// <summary>Delete, Ctrl+Z and Ctrl+Y on the chart page (DR2).</summary>
    private void OnKey(string key)
    {
        switch (key)
        {
            case "delete":
                if (Session.SelectedId != null)
                {
                    Session.Delete(Session.SelectedId.Value);
                }

                break;
            case "undo":
                Session.Undo();
                break;
            case "redo":
                Session.Redo();
                break;
        }
    }

    /// <summary>SC22: the context timeframes of an expert scenario.</summary>
    private bool RangeEnabled => Timeframe == "1d" || Timeframe == "4h";

    private async Task ChooseRangeToolAsync(bool on)
    {
        if (on)
        {
            _pattern = null; // the range tool is no Elliott pattern; putting it away leaves the tool just chosen alone
        }

        if (_chart != null)
        {
            await _chart.SetRangeToolAsync(on && RangeEnabled); // the chart answers with RangeToolChanged
        }
    }

    /// <summary>
    /// SC22: the range becomes the dialog of a new expert scenario: this asset, this timeframe as the context, the
    /// days from the first candle to the end of the day of the last one (UTC).
    /// </summary>
    private void OnRangeSelected((DateTimeOffset From, DateTimeOffset To) range)
    {
        var from = range.From.UtcDateTime.Date;
        var to = range.To.UtcDateTime.Date;
        if (range.To.UtcDateTime.TimeOfDay > TimeSpan.Zero || to <= from)
        {
            to = to.AddDays(1); // the day of the last candle stays inside the span
        }

        Navigation.NavigateTo("scenarios/expert?new"
            + "&source=" + Uri.EscapeDataString(Source)
            + "&symbol=" + Uri.EscapeDataString(Symbol)
            + "&context=" + Uri.EscapeDataString(Timeframe)
            + "&from=" + from.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
            + "&to=" + to.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
    }

    private async Task ChooseToolAsync(string? tool)
    {
        _pattern = null; // a tool of the rail, also the free polyline, is not a pattern
        if (tool == "waveLabel" || tool == "polyline")
        {
            _lastPattern = tool; // the Elliott group shows it next time
        }

        if (_chart != null)
        {
            await _chart.SetToolAsync(tool, ToolExtras(tool)); // the chart answers with ToolChanged
        }
    }

    /// <summary>The magnet is one setting for all charts (DR2): it shows at once and is saved in the background.</summary>
    private async Task SetMagnetAsync(bool magnet)
    {
        _magnet = magnet;
        await PushOptionsAsync();
        _ = Workspace.SaveMagnetAsync(magnet);
    }

    /// <summary>All drawings of the asset hidden or shown (DR6), saved per asset (CP2).</summary>
    private async Task SetHiddenAsync(bool hidden)
    {
        _hidden = hidden;
        await PushOptionsAsync();
        var problem = await SaveChartSettingsAsync();
        _drawingError = problem == null ? null : "Not saved: " + problem;
    }

    private static string Key(string source, string symbol)
    {
        return source + "/" + symbol;
    }

    /// <summary>What the chart shows right now; it follows the address once the settings of the asset are read.</summary>
    private sealed record ShownSeries(string Source, string Symbol, string Timeframe, double TickSize, IReadOnlyList<string> Timeframes);
}
