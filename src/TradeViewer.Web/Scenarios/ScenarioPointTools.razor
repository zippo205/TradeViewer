@* The point tools of the level shown (SC10, decision 0012): "1-2" on the context; the internals of waves 1 and 2 on
   the setup; the trade on the trigger, for trade-win and trade-loss only. Undo and redo are in the tool rail (SC20). *@
<div class="segments scenario-tools" role="group" aria-label="Point tools">
    @foreach (var tool in Tools)
    {
        <button type="button" class="@(tool.Tool.Code == Active ? "selected" : "")" title="@tool.Title"
                @onclick="() => OnChoose.InvokeAsync(tool.Tool.Code == Active ? null : tool)">
            @tool.Label
        </button>
    }
    @if (Tools.Count == 0)
    {
        <span class="muted scenario-tools-none">@NoneText</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ScenarioPointTool> Tools { get; set; } = Array.Empty<ScenarioPointTool>();

    /// <summary>The code of the tool in use, null for the pointer.</summary>
    [Parameter]
    public string? Active { get; set; }

    [Parameter]
    public string Level { get; set; } = ScenarioPoints.Context;

    /// <summary>A tool chosen, or null when the tool in use is chosen again (back to the pointer).</summary>
    [Parameter]
    public EventCallback<ScenarioPointTool?> OnChoose { get; set; }

    private string NoneText => Level == ScenarioPoints.Trigger ? "The trade is placed for trade-win and trade-loss" : "No point tools on this level";
}
